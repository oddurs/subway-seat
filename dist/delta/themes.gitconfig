# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
[delta "subway-seat"]
	dark = true
	syntax-theme = Subway Seat
	plus-style = syntax "#554C29"
	plus-emph-style = syntax "#686433"
	minus-style = syntax "#5B3223"
	minus-emph-style = syntax "#843F2D"
	map-styles = bold purple => syntax "#60422E", bold cyan => syntax "#4A4838"
	line-numbers-plus-style = "#ADB956"
	line-numbers-minus-style = "#F97160"
	line-numbers-zero-style = "#7B6047"
	line-numbers-left-style = "#634932"
	line-numbers-right-style = "#634932"
	file-style = "#F3BF45" bold
	file-decoration-style = "#EC7F31" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#634932" box
	hunk-header-line-number-style = "#EC7F31"
	commit-decoration-style = "#EC7F31" box
	blame-palette = "#362619 #2A1D13 #43301F"
	merge-conflict-begin-symbol = ~
	merge-conflict-end-symbol = ~
	merge-conflict-ours-diff-header-style = "#F3BF45" bold
	merge-conflict-theirs-diff-header-style = "#86AD95" bold

[delta "subway-seat-tunnel"]
	dark = true
	syntax-theme = Subway Seat Tunnel
	plus-style = syntax "#484221"
	plus-emph-style = syntax "#5E5C2C"
	minus-style = syntax "#4D271A"
	minus-emph-style = syntax "#7A3727"
	map-styles = bold purple => syntax "#533726", bold cyan => syntax "#3C3D30"
	line-numbers-plus-style = "#ADB956"
	line-numbers-minus-style = "#F97160"
	line-numbers-zero-style = "#745B45"
	line-numbers-left-style = "#4F3927"
	line-numbers-right-style = "#4F3927"
	file-style = "#F3BF45" bold
	file-decoration-style = "#EC7F31" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#4F3927" box
	hunk-header-line-number-style = "#EC7F31"
	commit-decoration-style = "#EC7F31" box
	blame-palette = "#24180E #1B120A #302115"
	merge-conflict-begin-symbol = ~
	merge-conflict-end-symbol = ~
	merge-conflict-ours-diff-header-style = "#F3BF45" bold
	merge-conflict-theirs-diff-header-style = "#86AD95" bold

[delta "subway-seat-enamel"]
	dark = false
	syntax-theme = Subway Seat Enamel
	plus-style = syntax "#CFCBA1"
	plus-emph-style = syntax "#B8B881"
	minus-style = syntax "#E0BEAB"
	minus-emph-style = syntax "#CA8E7E"
	map-styles = bold purple => syntax "#E0C4AC", bold cyan => syntax "#C6CBB5"
	line-numbers-plus-style = "#66740F"
	line-numbers-minus-style = "#BC4031"
	line-numbers-zero-style = "#A58C6A"
	line-numbers-left-style = "#BAA07A"
	line-numbers-right-style = "#BAA07A"
	file-style = "#936200" bold
	file-decoration-style = "#AD4E00" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#BAA07A" box
	hunk-header-line-number-style = "#AD4E00"
	commit-decoration-style = "#AD4E00" box
	blame-palette = "#F4E9D4 #EBDEC6 #D9C8A7"
	merge-conflict-begin-symbol = ~
	merge-conflict-end-symbol = ~
	merge-conflict-ours-diff-header-style = "#936200" bold
	merge-conflict-theirs-diff-header-style = "#3E7157" bold
