# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
[delta "paris-carrelage"]
	light = true
	syntax-theme = Paris Carrelage
	# changed lines: syntax colors on a tint; changed words on a stronger one
	plus-style = syntax "#C5DECE"
	plus-non-emph-style = syntax "#C5DECE"
	plus-emph-style = syntax "#A6CCB3"
	minus-style = syntax "#E9D5D4"
	minus-non-emph-style = syntax "#E9D5D4"
	minus-emph-style = syntax "#DCBCBB"
	zero-style = syntax
	whitespace-error-style = normal "#932D29"
	# git --color-moved: git's defaults and the git port's colors
	map-styles = bold purple => syntax "#F2E6E5", bold "#804B00" => syntax "#F2E6E5", bold blue => syntax "#E2D9BF", bold "#27629C" => syntax "#E2D9BF", bold cyan => syntax "#DBEBE1", bold "#006E6B" => syntax "#DBEBE1", bold yellow => syntax "#E2D9BF", bold "#8E6B08" => syntax "#E2D9BF"
	# line numbers (with line-numbers = true) in the color of their change
	line-numbers-plus-style = "#207F41"
	line-numbers-minus-style = "#BE423D"
	line-numbers-zero-style = "#6E7C6E"
	line-numbers-left-style = "#879887"
	line-numbers-right-style = "#879887"
	# file and hunk headers
	file-style = "#1B221C" bold
	file-decoration-style = "#804B00" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#3D473E"
	hunk-header-line-number-style = "#27629C"
	hunk-header-decoration-style = "#27629C" box
	commit-decoration-style = "#8E6B08" box
	inline-hint-style = "#6E7C6E"
	# git blame
	blame-palette = "#EEF3ED #E1E7E0 #D4DCD3"
	blame-separator-style = "#879887"
	# git grep / rg --json
	grep-file-style = "#804B00"
	grep-line-number-style = "#207F41"
	grep-match-line-style = syntax
	grep-match-word-style = "#1B221C" "#D1CAA8" bold
	grep-header-file-style = "#804B00" bold
	# merge conflicts (git's diff3 or zdiff3 conflict style)
	merge-conflict-ours-diff-header-style = "#8E6B08" bold
	merge-conflict-ours-diff-header-decoration-style = "#8E6B08" box
	merge-conflict-theirs-diff-header-style = "#006E6B" bold
	merge-conflict-theirs-diff-header-decoration-style = "#006E6B" box
