# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
[delta "paris-catacombes"]
	dark = true
	syntax-theme = Paris Catacombes
	# changed lines: syntax colors on a tint; changed words on a stronger one
	plus-style = syntax "#243729"
	plus-non-emph-style = syntax "#243729"
	plus-emph-style = syntax "#324D39"
	minus-style = syntax "#3D2823"
	minus-non-emph-style = syntax "#3D2823"
	minus-emph-style = syntax "#58342F"
	zero-style = syntax
	whitespace-error-style = normal "#CD6B63"
	# git --color-moved: git's defaults and the git port's colors
	map-styles = bold purple => syntax "#2B1F1C", bold "#D0914F" => syntax "#2B1F1C", bold blue => syntax "#2F2C17", bold "#709BC8" => syntax "#2F2C17", bold cyan => syntax "#1B291F", bold "#5FA09D" => syntax "#1B291F", bold yellow => syntax "#2F2C17", bold "#F2BF4B" => syntax "#2F2C17"
	# line numbers (with line-numbers = true) in the color of their change
	line-numbers-plus-style = "#80C28E"
	line-numbers-minus-style = "#EE8F85"
	line-numbers-zero-style = "#708178"
	line-numbers-left-style = "#54655C"
	line-numbers-right-style = "#54655C"
	# file and hunk headers
	file-style = "#E7ECEA" bold
	file-decoration-style = "#D0914F" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#BFC8C2"
	hunk-header-line-number-style = "#709BC8"
	hunk-header-decoration-style = "#709BC8" box
	commit-decoration-style = "#F2BF4B" box
	inline-hint-style = "#708178"
	# git blame
	blame-palette = "#121E19 #0D1711 #1A2921"
	blame-separator-style = "#54655C"
	# git grep / rg --json
	grep-file-style = "#D0914F"
	grep-line-number-style = "#80C28E"
	grep-match-line-style = syntax
	grep-match-word-style = "#E7ECEA" "#554E28" bold
	grep-header-file-style = "#D0914F" bold
	# merge conflicts (git's diff3 or zdiff3 conflict style)
	merge-conflict-ours-diff-header-style = "#F2BF4B" bold
	merge-conflict-ours-diff-header-decoration-style = "#F2BF4B" box
	merge-conflict-theirs-diff-header-style = "#5FA09D" bold
	merge-conflict-theirs-diff-header-decoration-style = "#5FA09D" box
