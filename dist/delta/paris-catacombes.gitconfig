# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
[delta "paris-catacombes"]
	dark = true
	syntax-theme = Paris Catacombes
	# changed lines: syntax colors on a tint; changed words on a stronger one
	plus-style = syntax "#1D3A27"
	plus-non-emph-style = syntax "#1D3A27"
	plus-emph-style = syntax "#2A4F35"
	minus-style = syntax "#3C2620"
	minus-non-emph-style = syntax "#3C2620"
	minus-emph-style = syntax "#5A312A"
	zero-style = syntax
	whitespace-error-style = normal "#DA6058"
	# git --color-moved: git's defaults and the git port's colors
	map-styles = bold purple => syntax "#291F19", bold "#D78E3C" => syntax "#291F19", bold blue => syntax "#2A2E15", bold "#639BD5" => syntax "#2A2E15", bold cyan => syntax "#142B1D", bold "#6FB393" => syntax "#142B1D", bold yellow => syntax "#2A2E15", bold "#EBC342" => syntax "#2A2E15"
	# line numbers (with line-numbers = true) in the color of their change
	line-numbers-plus-style = "#73C686"
	line-numbers-minus-style = "#EF796F"
	line-numbers-zero-style = "#648576"
	line-numbers-left-style = "#456A5B"
	line-numbers-right-style = "#456A5B"
	# file and hunk headers
	file-style = "#E4EEE9" bold
	file-decoration-style = "#D78E3C" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#B8CAC2"
	hunk-header-line-number-style = "#639BD5"
	hunk-header-decoration-style = "#639BD5" box
	commit-decoration-style = "#EBC342" box
	inline-hint-style = "#648576"
	# git blame
	blame-palette = "#062017 #061811 #0A2B20"
	blame-separator-style = "#456A5B"
	# git grep / rg --json
	grep-file-style = "#D78E3C"
	grep-line-number-style = "#73C686"
	grep-match-line-style = syntax
	grep-match-word-style = "#E4EEE9" "#4B5124" bold
	grep-header-file-style = "#D78E3C" bold
	# merge conflicts (git's diff3 or zdiff3 conflict style)
	merge-conflict-ours-diff-header-style = "#EBC342" bold
	merge-conflict-ours-diff-header-decoration-style = "#EBC342" box
	merge-conflict-theirs-diff-header-style = "#6FB393" bold
	merge-conflict-theirs-diff-header-decoration-style = "#6FB393" box
