# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Guimard for btop.

# Main background, empty for terminal default
theme[main_bg]="#1E2E26"

# Main text color
theme[main_fg]="#D9E1DB"

# Title color for boxes
theme[title]="#E9EEEC"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#D0914F"

# Background of the selected item in the processes box
theme[selected_bg]="#30463B"

# Foreground of the selected item in the processes box
theme[selected_fg]="#FFD273"

# Inactive or disabled text
theme[inactive_fg]="#586B61"

# Text drawn over graphs: uptime, network graph scale
theme[graph_text]="#A9B5AE"

# Background of the percentage meters
theme[meter_bg]="#30463B"

# Mini cpu graphs, detailed memory graph and status text in the processes box
theme[proc_misc]="#5FA09D"

# Box outlines
theme[cpu_box]="#D0914F"
theme[mem_box]="#F2BF4B"
theme[net_box]="#80C28E"
theme[proc_box]="#CE96B4"

# Box dividers and small box outlines
theme[div_line]="#3E554A"

# Temperature graph
theme[temp_start]="#80C28E"
theme[temp_mid]="#E1A84D"
theme[temp_end]="#CD6B63"

# CPU graph
theme[cpu_start]="#80C28E"
theme[cpu_mid]="#E1A84D"
theme[cpu_end]="#CD6B63"

# Mem/disk free meter
theme[free_start]="#547F5F"
theme[free_mid]="#80C28E"
theme[free_end]="#8FD59E"

# Mem/disk cached meter
theme[cached_start]="#4B6A7F"
theme[cached_mid]="#709BC8"
theme[cached_end]="#8DB6E2"

# Mem/disk available meter
theme[available_start]="#937E3A"
theme[available_mid]="#F2BF4B"
theme[available_end]="#FFD273"

# Mem/disk used meter
theme[used_start]="#D0914F"
theme[used_mid]="#CD6B63"
theme[used_end]="#EE8F85"

# Download graph
theme[download_start]="#547F5F"
theme[download_mid]="#80C28E"
theme[download_end]="#F2BF4B"

# Upload graph
theme[upload_start]="#80643D"
theme[upload_mid]="#D0914F"
theme[upload_end]="#EE8F85"

# Process box gradient for threads, memory and cpu usage
theme[process_start]="#80C28E"
theme[process_mid]="#E1A84D"
theme[process_end]="#CD6B63"

# Banners over the process list while it is paused or following a process
theme[proc_pause_bg]="#CD6B63"
theme[proc_follow_bg]="#5FA09D"
theme[proc_banner_bg]="#D0914F"
theme[proc_banner_fg]="#131A17"

# The process being followed
theme[followed_bg]="#5FA09D"
theme[followed_fg]="#131A17"
