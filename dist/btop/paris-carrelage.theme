# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Carrelage for btop.

# Main background, empty for terminal default
theme[main_bg]="#EEF3ED"

# Main text color
theme[main_fg]="#2A342B"

# Title color for boxes
theme[title]="#1B221C"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#804B00"

# Background of the selected item in the processes box
theme[selected_bg]="#B1C0B0"

# Foreground of the selected item in the processes box
theme[selected_fg]="#1B221C"

# Inactive or disabled text
theme[inactive_fg]="#879887"

# Text drawn over graphs: uptime, network graph scale
theme[graph_text]="#4C574D"

# Background of the percentage meters
theme[meter_bg]="#B1C0B0"

# Mini cpu graphs, detailed memory graph and status text in the processes box
theme[proc_misc]="#006E6B"

# Box outlines
theme[cpu_box]="#804B00"
theme[mem_box]="#8E6B08"
theme[net_box]="#207F41"
theme[proc_box]="#98547C"

# Box dividers and small box outlines
theme[div_line]="#9BAC9A"

# Temperature graph
theme[temp_start]="#207F41"
theme[temp_mid]="#875B04"
theme[temp_end]="#932D29"

# CPU graph
theme[cpu_start]="#207F41"
theme[cpu_mid]="#875B04"
theme[cpu_end]="#932D29"

# Mem/disk free meter
theme[free_start]="#7DB38E"
theme[free_mid]="#207F41"
theme[free_end]="#168540"

# Mem/disk cached meter
theme[cached_start]="#81A3C0"
theme[cached_mid]="#27629C"
theme[cached_end]="#3E75AD"

# Mem/disk available meter
theme[available_start]="#B9A86F"
theme[available_mid]="#8E6B08"
theme[available_end]="#9D770A"

# Mem/disk used meter
theme[used_start]="#804B00"
theme[used_mid]="#932D29"
theme[used_end]="#BE423D"

# Download graph
theme[download_start]="#7DB38E"
theme[download_mid]="#207F41"
theme[download_end]="#8E6B08"

# Upload graph
theme[upload_start]="#B2976B"
theme[upload_mid]="#804B00"
theme[upload_end]="#BE423D"

# Process box gradient for threads, memory and cpu usage
theme[process_start]="#207F41"
theme[process_mid]="#875B04"
theme[process_end]="#932D29"

# Banners over the process list while it is paused or following a process
theme[proc_pause_bg]="#932D29"
theme[proc_follow_bg]="#006E6B"
theme[proc_banner_bg]="#804B00"
theme[proc_banner_fg]="#EEF3ED"

# The process being followed
theme[followed_bg]="#006E6B"
theme[followed_fg]="#EEF3ED"
