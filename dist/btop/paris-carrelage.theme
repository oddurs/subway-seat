# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Carrelage for btop.

# Main background, empty for terminal default
theme[main_bg]="#DEF0E6"

# Main text color
theme[main_fg]="#25352C"

# Title color for boxes
theme[title]="#18231D"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#754500"

# Background of the selected item in the processes box
theme[selected_bg]="#96C4AC"

# Foreground of the selected item in the processes box
theme[selected_fg]="#18231D"

# Inactive or disabled text
theme[inactive_fg]="#769B87"

# Text drawn over graphs: uptime, network graph scale
theme[graph_text]="#45594F"

# Background of the percentage meters
theme[meter_bg]="#96C4AC"

# Mini cpu graphs, detailed memory graph and status text in the processes box
theme[proc_misc]="#086142"

# Box outlines
theme[cpu_box]="#754500"
theme[mem_box]="#8A6700"
theme[net_box]="#207F41"
theme[proc_box]="#9A557D"

# Box dividers and small box outlines
theme[div_line]="#84B09A"

# Temperature graph
theme[temp_start]="#207F41"
theme[temp_mid]="#805600"
theme[temp_end]="#932D29"

# CPU graph
theme[cpu_start]="#207F41"
theme[cpu_mid]="#805600"
theme[cpu_end]="#932D29"

# Mem/disk free meter
theme[free_start]="#76B28B"
theme[free_mid]="#207F41"
theme[free_end]="#168540"

# Mem/disk cached meter
theme[cached_start]="#79A2BD"
theme[cached_mid]="#27629C"
theme[cached_end]="#3E75AD"

# Mem/disk available meter
theme[available_start]="#B0A567"
theme[available_mid]="#8A6700"
theme[available_end]="#997300"

# Mem/disk used meter
theme[used_start]="#754500"
theme[used_mid]="#932D29"
theme[used_end]="#BB403B"

# Download graph
theme[download_start]="#76B28B"
theme[download_mid]="#207F41"
theme[download_end]="#8A6700"

# Upload graph
theme[upload_start]="#A49267"
theme[upload_mid]="#754500"
theme[upload_end]="#BB403B"

# Process box gradient for threads, memory and cpu usage
theme[process_start]="#207F41"
theme[process_mid]="#805600"
theme[process_end]="#932D29"

# Banners over the process list while it is paused or following a process
theme[proc_pause_bg]="#932D29"
theme[proc_follow_bg]="#086142"
theme[proc_banner_bg]="#754500"
theme[proc_banner_fg]="#DEF0E6"

# The process being followed
theme[followed_bg]="#086142"
theme[followed_fg]="#DEF0E6"
