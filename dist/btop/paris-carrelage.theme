# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Carrelage for btop.

# Main background, empty for terminal default
theme[main_bg]="#E4EDE8"

# Main text color
theme[main_fg]="#25352C"

# Title color for boxes
theme[title]="#18231D"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9B5D00"

# Background of the selected item in the processes box
theme[selected_bg]="#A3BFB0"

# Foreground of the selected item in the processes box
theme[selected_fg]="#18231D"

# Inactive or disabled text
theme[inactive_fg]="#7B9989"

# Text drawn over graphs: uptime, network graph scale
theme[graph_text]="#45594F"

# Background of the percentage meters
theme[meter_bg]="#A3BFB0"

# Mini cpu graphs, detailed memory graph and status text in the processes box
theme[proc_misc]="#277555"

# Box outlines
theme[cpu_box]="#9B5D00"
theme[mem_box]="#8A6700"
theme[net_box]="#18803F"
theme[proc_box]="#9A557D"

# Box dividers and small box outlines
theme[div_line]="#8EAD9D"

# Temperature graph
theme[temp_start]="#18803F"
theme[temp_mid]="#926200"
theme[temp_end]="#9E171B"

# CPU graph
theme[cpu_start]="#18803F"
theme[cpu_mid]="#926200"
theme[cpu_end]="#9E171B"

# Mem/disk free meter
theme[free_start]="#74B18B"
theme[free_mid]="#18803F"
theme[free_end]="#168540"

# Mem/disk cached meter
theme[cached_start]="#7CA1BE"
theme[cached_mid]="#27629C"
theme[cached_end]="#3E75AD"

# Mem/disk available meter
theme[available_start]="#B2A368"
theme[available_mid]="#8A6700"
theme[available_end]="#997300"

# Mem/disk used meter
theme[used_start]="#9B5D00"
theme[used_mid]="#9E171B"
theme[used_end]="#BB403B"

# Download graph
theme[download_start]="#74B18B"
theme[download_mid]="#18803F"
theme[download_end]="#8A6700"

# Upload graph
theme[upload_start]="#BC9E68"
theme[upload_mid]="#9B5D00"
theme[upload_end]="#BB403B"

# Process box gradient for threads, memory and cpu usage
theme[process_start]="#18803F"
theme[process_mid]="#926200"
theme[process_end]="#9E171B"

# Banners over the process list while it is paused or following a process
theme[proc_pause_bg]="#9E171B"
theme[proc_follow_bg]="#277555"
theme[proc_banner_bg]="#9B5D00"
theme[proc_banner_fg]="#E4EDE8"

# The process being followed
theme[followed_bg]="#277555"
theme[followed_fg]="#E4EDE8"
