# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Guimard — Cast iron off a Metro entrance, which is nearly black. Brass leads.

color-link default "#D9E1DB,#1E2E26"
color-link comment "italic #74857C"
color-link comment.bright "italic #909E96"
color-link identifier "#F1BF4B"
color-link identifier.class "#F1BF4B"
color-link identifier.macro "italic #FAB49C"
color-link identifier.var "#D9E1DB"
color-link constant "#E7877B"
