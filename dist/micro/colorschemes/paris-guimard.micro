# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Guimard — Cast iron off a Metro entrance, which is nearly black. Brass leads.

color-link default "#DAE0DC,#212D27"
color-link comment "italic #77847D"
color-link comment.bright "italic #929D97"
color-link identifier "#EBC168"
color-link identifier.class "#EBC168"
color-link identifier.macro "italic #CE96B4"
color-link identifier.var "#DAE0DC"
color-link constant "#E1837A"
color-link constant.bool "#E1837A"
color-link constant.number "#E1837A"
color-link constant.specialChar "#CE96B4"
color-link constant.string "#80C28E"
color-link constant.string.url "underline #709BC8"
color-link statement "#D0914F"
color-link symbol "#929D97"
color-link symbol.brackets "#929D97"
color-link symbol.operator "#929D97"
color-link symbol.tag "#D0914F"
color-link preproc "#CE96B4"
color-link preproc.shebang "italic #77847D"
color-link type "#7BB096"
color-link type.keyword "#D0914F"
color-link type.extended "#7BB096"
color-link special "#CE96B4"
color-link underlined "underline #709BC8"
color-link error "#E1837A"
color-link todo "bold #141A17,#EBC168"
color-link selection "#EAEEEC,#42544B"
color-link cursor-line "#2A3831"
color-link color-column "#2A3831"
color-link line-number "#5B6A62,#212D27"
color-link current-line-number "bold #EBC168,#2A3831"
color-link gutter-info "#709BC8"
color-link gutter-warning "#EBC168"
color-link gutter-error "#E1837A"
color-link diff-added "#80C28E"
color-link diff-modified "#EBC168"
color-link diff-deleted "#E1837A"
color-link statusline "#C3CAC6,#1A231E"
color-link statusline.inactive "#5B6A62,#141A17"
color-link statusline.suggestions "#C3CAC6,#1A231E"
color-link tabbar "#77847D,#141A17"
color-link tabbar.active "bold #EAEEEC,#212D27"
color-link indent-char "#34453C"
color-link divider "#141A17,#141A17"
color-link scrollbar "#42544B"
color-link message "#C3CAC6"
color-link error-message "bold #E1837A"
color-link match-brace "bold #FBD380,#34453C"
