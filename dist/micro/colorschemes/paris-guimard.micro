color-link constant.number "#E7877B"
color-link constant.specialChar "#FAB49C"
color-link constant.string "#70CAA9"
color-link constant.string.url "underline #709BC8"
color-link statement "#CA9245"
color-link symbol "#909E96"
color-link symbol.brackets "#909E96"
color-link symbol.operator "#909E96"
color-link symbol.tag "#CA9245"
color-link preproc "#FAB49C"
