# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Guimard — Cast-iron green off a Metro entrance. The original green.

color-link default "#D3E2DB,#0E3125"
color-link comment "italic #67897A"
color-link comment.bright "italic #86A195"
color-link identifier "#EBC342"
color-link identifier.class "#EBC342"
color-link identifier.macro "italic #E783BD"
color-link identifier.var "#D3E2DB"
color-link constant "#EF796F"
color-link constant.bool "#EF796F"
color-link constant.number "#EF796F"
color-link constant.specialChar "#E783BD"
color-link constant.string "#73C686"
color-link constant.string.url "underline #639BD5"
color-link statement "#D78E3C"
color-link symbol "#86A195"
color-link symbol.brackets "#86A195"
color-link symbol.operator "#86A195"
color-link symbol.tag "#D78E3C"
color-link preproc "#E783BD"
color-link preproc.shebang "italic #67897A"
color-link type "#6FB393"
color-link type.keyword "#D78E3C"
color-link type.extended "#6FB393"
color-link special "#E783BD"
color-link underlined "underline #639BD5"
color-link error "#EF796F"
color-link todo "bold #0A1D15,#EBC342"
color-link selection "#E6F0EB,#285A47"
color-link cursor-line "#113E2E"
color-link color-column "#113E2E"
color-link line-number "#47705F,#0E3125"
color-link current-line-number "bold #EBC342,#113E2E"
color-link gutter-info "#639BD5"
color-link gutter-warning "#EBC342"
color-link gutter-error "#EF796F"
color-link diff-added "#73C686"
color-link diff-modified "#EBC342"
color-link diff-deleted "#EF796F"
color-link statusline "#BBCDC5,#0C261C"
color-link statusline.inactive "#47705F,#0A1D15"
color-link statusline.suggestions "#BBCDC5,#0C261C"
color-link tabbar "#67897A,#0A1D15"
color-link tabbar.active "bold #E6F0EB,#0E3125"
color-link indent-char "#194A39"
color-link divider "#0A1D15,#0A1D15"
color-link scrollbar "#285A47"
color-link message "#BBCDC5"
color-link error-message "bold #EF796F"
color-link match-brace "bold #FBD664,#194A39"
color-link hlsearch "#D3E2DB,#505D2E"
