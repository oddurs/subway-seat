color-link type "#549B9F"
color-link type.keyword "#CA9245"
color-link type.extended "#549B9F"
color-link special "#FAB49C"
color-link underlined "underline #709BC8"
color-link error "#E7877B"
color-link todo "bold #131A17,#F1BF4B"
