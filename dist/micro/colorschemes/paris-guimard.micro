color-link type "#6CA087"
color-link type.keyword "#D0914F"
color-link type.extended "#6CA087"
color-link special "#CE96B4"
color-link underlined "underline #709BC8"
color-link error "#E1837A"
color-link todo "bold #131A17,#EBC168"
color-link selection "#E9EEEC,#3E554A"
color-link cursor-line "#263930"
color-link color-column "#263930"
