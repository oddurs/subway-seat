# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Catacombes — Under the quarries: the same green with the lights turned down.

color-link default "#CFDED7,#062017"
color-link comment "italic #648576"
color-link comment.bright "italic #829D91"
color-link identifier "#EBC342"
color-link identifier.class "#EBC342"
color-link identifier.macro "italic #E783BD"
color-link identifier.var "#CFDED7"
color-link constant "#EF796F"
color-link constant.bool "#EF796F"
color-link constant.number "#EF796F"
color-link constant.specialChar "#E783BD"
color-link constant.string "#73C686"
color-link constant.string.url "underline #639BD5"
color-link statement "#D78E3C"
color-link symbol "#829D91"
color-link symbol.brackets "#829D91"
color-link symbol.operator "#829D91"
color-link symbol.tag "#D78E3C"
color-link preproc "#E783BD"
color-link preproc.shebang "italic #648576"
color-link type "#6FB393"
color-link type.keyword "#D78E3C"
color-link type.extended "#6FB393"
color-link special "#E783BD"
color-link underlined "underline #639BD5"
color-link error "#EF796F"
color-link todo "bold #05120C,#EBC342"
color-link selection "#E4EEE9,#1E4738"
color-link cursor-line "#0A2B20"
color-link color-column "#0A2B20"
color-link line-number "#456A5B,#062017"
color-link current-line-number "bold #EBC342,#0A2B20"
color-link gutter-info "#639BD5"
color-link gutter-warning "#EBC342"
color-link gutter-error "#EF796F"
color-link diff-added "#73C686"
color-link diff-modified "#EBC342"
color-link diff-deleted "#EF796F"
color-link statusline "#B8CAC2,#061811"
