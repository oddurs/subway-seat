color-link type "#7BB096"
color-link type.keyword "#D0914F"
color-link type.extended "#7BB096"
color-link special "#CE96B4"
color-link underlined "underline #709BC8"
color-link error "#E1837A"
color-link todo "bold #0B100D,#EBC168"
color-link selection "#E8ECEA,#34423B"
color-link cursor-line "#1D2822"
color-link color-column "#1D2822"
color-link line-number "#57645D,#141D19"
color-link current-line-number "bold #EBC168,#1D2822"
