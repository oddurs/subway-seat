# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# London Deep Level — Below the cut-and-cover lines. The ground drops; the signals don't.

color-link default "#D4DAE7,#121A2D"
color-link comment "italic #6F7C97"
color-link comment.bright "italic #8B96AC"
color-link identifier "#F2C03F"
color-link identifier.class "#F2C03F"
color-link identifier.macro "italic #AE9EDC"
color-link identifier.var "#D4DAE7"
color-link constant "#F17869"
color-link constant.bool "#F17869"
color-link constant.number "#F17869"
color-link constant.specialChar "#AE9EDC"
color-link constant.string "#77C581"
color-link constant.string.url "underline #7595DA"
color-link statement "#DE8946"
color-link symbol "#8B96AC"
color-link symbol.brackets "#8B96AC"
color-link symbol.operator "#8B96AC"
color-link symbol.tag "#DE8946"
color-link preproc "#AE9EDC"
color-link preproc.shebang "italic #6F7C97"
color-link type "#54B4B5"
color-link type.keyword "#DE8946"
color-link type.extended "#54B4B5"
color-link special "#AE9EDC"
color-link underlined "underline #7595DA"
color-link error "#F17869"
color-link todo "bold #0A0E18,#F2C03F"
color-link selection "#E7EBF3,#303E5B"
color-link cursor-line "#1A243A"
color-link color-column "#1A243A"
color-link line-number "#53617D,#121A2D"
color-link current-line-number "bold #F2C03F,#1A243A"
color-link gutter-info "#7595DA"
color-link gutter-warning "#F2C03F"
color-link gutter-error "#F17869"
color-link diff-added "#77C581"
color-link diff-modified "#F2C03F"
color-link diff-deleted "#F17869"
color-link statusline "#BEC6D5,#0D1421"
color-link statusline.inactive "#53617D,#0A0E18"
color-link statusline.suggestions "#BEC6D5,#0D1421"
color-link tabbar "#6F7C97,#0A0E18"
color-link tabbar.active "bold #E7EBF3,#121A2D"
color-link indent-char "#232F49"
color-link divider "#0A0E18,#0A0E18"
color-link scrollbar "#303E5B"
