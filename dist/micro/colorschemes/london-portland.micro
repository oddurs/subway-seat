# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# London Portland — Holden's Portland stone. Links are the exact Corporate Blue.

color-link default "#293040,#E5EAF4"
color-link comment "italic #697794"
color-link comment.bright "italic #556179"
color-link identifier "#896800"
color-link identifier.class "#896800"
color-link identifier.macro "italic #7660AB"
color-link identifier.var "#293040"
color-link constant "#C92B23"
color-link constant.bool "#C92B23"
color-link constant.number "#C92B23"
color-link constant.specialChar "#7660AB"
color-link constant.string "#0D8131"
color-link constant.string.url "underline #0019A8"
color-link statement "#B14A07"
color-link symbol "#556179"
color-link symbol.brackets "#556179"
color-link symbol.operator "#556179"
color-link symbol.tag "#B14A07"
color-link preproc "#7660AB"
color-link preproc.shebang "italic #697794"
color-link type "#007376"
color-link type.keyword "#B14A07"
color-link type.extended "#007376"
color-link special "#7660AB"
color-link underlined "underline #0019A8"
color-link error "#C92B23"
color-link todo "bold #E5EAF4,#896800"
color-link selection "#1B202B,#A9B7D4"
color-link cursor-line "#DAE0EB"
color-link color-column "#BFCAE1"
color-link line-number "#8291AE,#E5EAF4"
color-link current-line-number "bold #B14A07,#DAE0EB"
color-link gutter-info "#0019A8"
color-link gutter-warning "#896800"
color-link gutter-error "#C92B23"
color-link diff-added "#0D8131"
color-link diff-modified "#896800"
color-link diff-deleted "#C92B23"
color-link statusline "#3C4557,#DAE0EB"
color-link statusline.inactive "#8291AE,#CDD5E4"
color-link statusline.suggestions "#3C4557,#DAE0EB"
color-link tabbar "#697794,#CDD5E4"
color-link tabbar.active "bold #1B202B,#E5EAF4"
color-link indent-char "#A9B7D4"
color-link divider "#CDD5E4,#CDD5E4"
color-link scrollbar "#95A5C4"
color-link message "#3C4557"
color-link error-message "bold #C92B23"
color-link match-brace "bold #B14A07,#D8DDE7"
color-link hlsearch "#293040,#C9C3AB"
color-link tab-error ",#DCD2DA"
color-link trailingws ",#DCD2DA"
color-link ignore "#8291AE"
