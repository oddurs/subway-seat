# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# London Portland — Holden's Portland stone. Links are the exact Corporate Blue.

color-link default "#2F3033,#E5EAF6"
color-link comment "italic #727781"
color-link comment.bright "italic #5D6168"
color-link identifier "#896800"
color-link identifier.class "#896800"
color-link identifier.macro "italic #7660AB"
color-link identifier.var "#2F3033"
color-link constant "#CA2822"
color-link constant.bool "#CA2822"
color-link constant.number "#CA2822"
color-link constant.specialChar "#7660AB"
color-link constant.string "#357D41"
color-link constant.string.url "underline #0019A8"
color-link statement "#9F591B"
color-link symbol "#5D6168"
color-link symbol.brackets "#5D6168"
color-link symbol.operator "#5D6168"
color-link symbol.tag "#9F591B"
color-link preproc "#7660AB"
color-link preproc.shebang "italic #727781"
color-link type "#007376"
color-link type.keyword "#9F591B"
color-link type.extended "#007376"
color-link special "#7660AB"
color-link underlined "underline #0019A8"
color-link error "#CA2822"
color-link todo "bold #E5EAF6,#896800"
color-link selection "#1F2022,#ADB7CB"
color-link cursor-line "#D9E0EC"
color-link color-column "#C1CADC"
color-link line-number "#8A919F,#E5EAF6"
color-link current-line-number "bold #9F591B,#D9E0EC"
color-link gutter-info "#0019A8"
color-link gutter-warning "#896800"
color-link gutter-error "#CA2822"
color-link diff-added "#357D41"
color-link diff-modified "#896800"
color-link diff-deleted "#CA2822"
color-link statusline "#434548,#D9E0EC"
color-link statusline.inactive "#8A919F,#CED5E3"
color-link statusline.suggestions "#434548,#D9E0EC"
color-link tabbar "#727781,#CED5E3"
color-link tabbar.active "bold #1F2022,#E5EAF6"
color-link indent-char "#ADB7CB"
color-link divider "#CED5E3,#CED5E3"
color-link scrollbar "#9BA5B8"
color-link message "#434548"
color-link error-message "bold #CA2822"
color-link match-brace "bold #9F591B,#D8DDE8"
color-link hlsearch "#2F3033,#C9C3AC"
color-link tab-error ",#DDCED9"
color-link trailingws ",#DDCED9"
color-link ignore "#8A919F"
