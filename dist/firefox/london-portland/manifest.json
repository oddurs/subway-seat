{
  "manifest_version": 2,
  "name": "London Portland",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Holden's Portland stone. Links are the exact Corporate Blue.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "london-portland@oddurs.github.io",
      "strict_min_version": "106.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#CCDAF2",
      "frame_inactive": "#DCE5F7",
      "tab_background_text": "#556179",
      "tab_background_separator": "#A8BBE2",
      "tab_selected": "#E8F0FF",
      "tab_text": "#293040",
      "tab_line": "#A54300",
      "tab_loading": "#A54300",
      "toolbar": "#E8F0FF",
      "toolbar_text": "#293040",
      "toolbar_top_separator": "#CCDAF2",
      "toolbar_bottom_separator": "#A8BBE2",
      "toolbar_vertical_separator": "#A8BBE2",
      "icons": "#3C4557",
      "icons_attention": "#A54300",
      "button_background_hover": "#BFCFF1",
      "button_background_active": "#A8BBE2",
      "toolbar_field": "#DCE5F7",
      "toolbar_field_text": "#293040",
      "toolbar_field_border": "#A8BBE2",
      "toolbar_field_focus": "#E8F0FF",
      "toolbar_field_text_focus": "#1B202B",
      "toolbar_field_border_focus": "#A54300",
      "toolbar_field_highlight": "#A8BBE2",
      "toolbar_field_highlight_text": "#1B202B",
      "toolbar_field_separator": "#A8BBE2",
      "popup": "#F4F8FF",
      "popup_text": "#293040",
      "popup_border": "#D7DCE4",
      "popup_highlight": "#A8BBE2",
      "popup_highlight_text": "#1B202B",
      "sidebar": "#DCE5F7",
      "sidebar_text": "#293040",
      "sidebar_border": "#A8BBE2",
      "sidebar_highlight": "#A8BBE2",
      "sidebar_highlight_text": "#1B202B",
      "ntp_background": "#E8F0FF",
      "ntp_card_background": "#DCE5F7",
      "ntp_text": "#293040"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
