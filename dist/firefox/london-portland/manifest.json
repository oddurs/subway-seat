{
  "manifest_version": 2,
  "name": "London Portland",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Holden's Portland stone. Links are the exact Corporate Blue.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "london-portland@oddurs.github.io",
      "strict_min_version": "106.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#CDD5E4",
      "frame_inactive": "#DAE0EB",
      "tab_background_text": "#556179",
      "tab_background_separator": "#A9B7D4",
      "tab_selected": "#E5EAF4",
      "tab_text": "#293040",
      "tab_line": "#B14A07",
      "tab_loading": "#B14A07",
      "toolbar": "#E5EAF4",
      "toolbar_text": "#293040",
      "toolbar_top_separator": "#CDD5E4",
      "toolbar_bottom_separator": "#A9B7D4",
      "toolbar_vertical_separator": "#A9B7D4",
      "icons": "#3C4557",
      "icons_attention": "#B14A07",
      "button_background_hover": "#BFCAE1",
      "button_background_active": "#A9B7D4",
      "toolbar_field": "#DAE0EB",
      "toolbar_field_text": "#293040",
      "toolbar_field_border": "#A9B7D4",
      "toolbar_field_focus": "#E5EAF4",
      "toolbar_field_text_focus": "#1B202B",
      "toolbar_field_border_focus": "#B14A07",
      "toolbar_field_highlight": "#A9B7D4",
      "toolbar_field_highlight_text": "#1B202B",
      "toolbar_field_separator": "#A9B7D4",
      "popup": "#F2F4FA",
      "popup_text": "#293040",
      "popup_border": "#D6D8E0",
      "popup_highlight": "#A9B7D4",
      "popup_highlight_text": "#1B202B",
      "sidebar": "#DAE0EB",
      "sidebar_text": "#293040",
      "sidebar_border": "#A9B7D4",
      "sidebar_highlight": "#A9B7D4",
      "sidebar_highlight_text": "#1B202B",
      "ntp_background": "#E5EAF4",
      "ntp_card_background": "#DAE0EB",
      "ntp_text": "#293040"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
