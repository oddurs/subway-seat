{
  "manifest_version": 2,
  "name": "Paris Carrelage",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Bevelled white tile under a vaulted platform. The light one.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "paris-carrelage@oddurs.github.io",
      "strict_min_version": "106.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#D4DCD3",
      "frame_inactive": "#E1E7E0",
      "tab_background_text": "#586459",
      "tab_background_separator": "#B1C0B0",
      "tab_selected": "#EEF3ED",
      "tab_text": "#2A342B",
      "tab_line": "#804B00",
      "tab_loading": "#804B00",
      "toolbar": "#EEF3ED",
      "toolbar_text": "#2A342B",
      "toolbar_top_separator": "#D4DCD3",
      "toolbar_bottom_separator": "#B1C0B0",
      "toolbar_vertical_separator": "#B1C0B0",
      "icons": "#3D473E",
      "icons_attention": "#804B00",
      "button_background_hover": "#C7D3C5",
      "button_background_active": "#B1C0B0",
      "toolbar_field": "#E1E7E0",
      "toolbar_field_text": "#2A342B",
      "toolbar_field_border": "#B1C0B0",
      "toolbar_field_focus": "#EEF3ED",
      "toolbar_field_text_focus": "#1B221C",
      "toolbar_field_border_focus": "#804B00",
      "toolbar_field_highlight": "#B1C0B0",
      "toolbar_field_highlight_text": "#1B221C",
      "toolbar_field_separator": "#B1C0B0",
      "popup": "#F6F9F6",
      "popup_text": "#2A342B",
      "popup_border": "#D9DDD9",
      "popup_highlight": "#B1C0B0",
      "popup_highlight_text": "#1B221C",
      "sidebar": "#E1E7E0",
      "sidebar_text": "#2A342B",
      "sidebar_border": "#B1C0B0",
      "sidebar_highlight": "#B1C0B0",
      "sidebar_highlight_text": "#1B221C",
      "ntp_background": "#EEF3ED",
      "ntp_card_background": "#E1E7E0",
      "ntp_text": "#2A342B"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
