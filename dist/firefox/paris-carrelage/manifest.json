{
  "manifest_version": 2,
  "name": "Paris Carrelage",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Bevelled white tile under a vaulted platform. The light one.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "paris-carrelage@oddurs.github.io",
      "strict_min_version": "106.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#C8E0D3",
      "frame_inactive": "#D8EADF",
      "tab_background_text": "#4F675B",
      "tab_background_separator": "#9FC6B1",
      "tab_selected": "#E7F5ED",
      "tab_text": "#25352C",
      "tab_line": "#754500",
      "tab_loading": "#754500",
      "toolbar": "#E7F5ED",
      "toolbar_text": "#25352C",
      "toolbar_top_separator": "#C8E0D3",
      "toolbar_bottom_separator": "#9FC6B1",
      "toolbar_vertical_separator": "#9FC6B1",
      "icons": "#374940",
      "icons_attention": "#754500",
      "button_background_hover": "#B7D8C6",
      "button_background_active": "#9FC6B1",
      "toolbar_field": "#D8EADF",
      "toolbar_field_text": "#25352C",
      "toolbar_field_border": "#9FC6B1",
      "toolbar_field_focus": "#E7F5ED",
      "toolbar_field_text_focus": "#18231D",
      "toolbar_field_border_focus": "#754500",
      "toolbar_field_highlight": "#9FC6B1",
      "toolbar_field_highlight_text": "#18231D",
      "toolbar_field_separator": "#9FC6B1",
      "popup": "#F3FAF6",
      "popup_text": "#25352C",
      "popup_border": "#D6DED9",
      "popup_highlight": "#9FC6B1",
      "popup_highlight_text": "#18231D",
      "sidebar": "#D8EADF",
      "sidebar_text": "#25352C",
      "sidebar_border": "#9FC6B1",
      "sidebar_highlight": "#9FC6B1",
      "sidebar_highlight_text": "#18231D",
      "ntp_background": "#E7F5ED",
      "ntp_card_background": "#D8EADF",
      "ntp_text": "#25352C"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
