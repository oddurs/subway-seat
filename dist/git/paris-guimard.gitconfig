# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Guimard for Git. Include it from your gitconfig:
#   [include] path = ~/.config/git/paris-guimard.gitconfig

[color "diff"]
	meta = "#eaeeec bold"
	frag = "#709bc8"
	func = "#c3cac6"
	old = "#e1837a"
	new = "#80c28e"
	commit = "#ebc168"
	whitespace = "normal #cd6b63"
	oldMoved = "#d0914f bold"
	oldMovedAlternative = "#709bc8 bold"
	newMoved = "#7bb096 bold"
	newMovedAlternative = "#ebc168 bold"
	oldMovedDimmed = "#77847d"
	oldMovedAlternativeDimmed = "#77847d italic"
	newMovedDimmed = "#77847d"
	newMovedAlternativeDimmed = "#77847d italic"
	contextDimmed = "#77847d"
	oldDimmed = "#e1837a dim"
	newDimmed = "#80c28e dim"
	contextBold = "#eaeeec bold"
	oldBold = "#e1837a bold"
	newBold = "#80c28e bold"

[color "diff-highlight"]
	oldNormal = "#e1837a"
	oldHighlight = "#e1837a #5e3a35"
	newNormal = "#80c28e"
	newHighlight = "#80c28e #39533f"

[color "status"]
	header = "#c3cac6"
	added = "#80c28e"
	changed = "#e1837a"
	untracked = "#ce96b4"
	branch = "#80c28e bold"
	nobranch = "#e1837a bold"
	localBranch = "#80c28e"
	remoteBranch = "#e1837a"
	unmerged = "#e1837a bold"

[color "branch"]
	current = "#80c28e bold"
	local = "#dae0dc"
	remote = "#e1837a"
	upstream = "#709bc8"
	plain = "#c3cac6"
	worktree = "#7bb096"

[color "decorate"]
	HEAD = "#7bb096 bold"
	branch = "#80c28e bold"
	remoteBranch = "#e1837a bold"
	tag = "#ebc168 bold"
	stash = "#d0914f bold"
	grafted = "#709bc8 bold"

[color "grep"]
	context = "#abb4af"
	filename = "#d0914f"
	function = "#ebc168"
	lineNumber = "#80c28e"
	column = "#80c28e"
	selected = "#dae0dc"
	separator = "#77847d"

[color "interactive"]
	prompt = "#d0914f bold"
	header = "#eaeeec bold"
	help = "#ebc168"
	error = "#e1837a bold"

[color "blame"]
	highlightRecent = "#77847d,12 month ago,#c3cac6,1 month ago,#d0914f"
	repeatedLines = "#77847d"

[color "advice"]
	hint = "#ebc168"

[color "push"]
	error = "#e1837a"

[color "transport"]
	rejected = "#e1837a"

[color "remote"]
	hint = "#ebc168"
	warning = "#ebc168 bold"
	success = "#80c28e bold"
	error = "#e1837a bold"
