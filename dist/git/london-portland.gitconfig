# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# London Portland for Git. Include it from your gitconfig:
#   [include] path = ~/.config/git/london-portland.gitconfig

[color "diff"]
	meta = "#1b202b bold"
	frag = "#0019a8"
	func = "#3c4557"
	old = "#c92b23"
	new = "#00822e"
	commit = "#896800"
	whitespace = "normal #a40005"
	oldMoved = "#a45600 bold"
	oldMovedAlternative = "#0019a8 bold"
	newMoved = "#007376 bold"
	newMovedAlternative = "#896800 bold"
	oldMovedDimmed = "#697794"
	oldMovedAlternativeDimmed = "#697794 italic"
	newMovedDimmed = "#697794"
	newMovedAlternativeDimmed = "#697794 italic"
	contextDimmed = "#697794"
	oldDimmed = "#c92b23 dim"
	newDimmed = "#00822e dim"
	contextBold = "#1b202b bold"
	oldBold = "#c92b23 bold"
	newBold = "#00822e bold"

[color "diff-highlight"]
	oldNormal = "#c92b23"
	oldHighlight = "#c92b23 #e2adaf"
	newNormal = "#00822e"
	newHighlight = "#00822e #99cdab"

[color "status"]
	header = "#3c4557"
	added = "#00822e"
	changed = "#c92b23"
	untracked = "#7660ab"
	branch = "#00822e bold"
	nobranch = "#c92b23 bold"
	localBranch = "#00822e"
	remoteBranch = "#c92b23"
	unmerged = "#c92b23 bold"

[color "branch"]
	current = "#00822e bold"
	local = "#293040"
	remote = "#c92b23"
	upstream = "#0019a8"
	plain = "#3c4557"
	worktree = "#007376"

[color "decorate"]
	HEAD = "#007376 bold"
	branch = "#00822e bold"
	remoteBranch = "#c92b23 bold"
	tag = "#896800 bold"
	stash = "#a45600 bold"
	grafted = "#0019a8 bold"

[color "grep"]
	context = "#4a5469"
	filename = "#a45600"
	function = "#896800"
	lineNumber = "#00822e"
	column = "#00822e"
	selected = "#293040"
	separator = "#697794"

[color "interactive"]
	prompt = "#a45600 bold"
	header = "#1b202b bold"
	help = "#896800"
	error = "#c92b23 bold"

[color "blame"]
	highlightRecent = "#697794,12 month ago,#3c4557,1 month ago,#a45600"
	repeatedLines = "#697794"

[color "advice"]
	hint = "#896800"

[color "push"]
	error = "#c92b23"

[color "transport"]
	rejected = "#c92b23"

[color "remote"]
	hint = "#896800"
	warning = "#896800 bold"
	success = "#00822e bold"
	error = "#c92b23 bold"
