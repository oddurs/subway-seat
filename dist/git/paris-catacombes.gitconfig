# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Catacombes for Git. Include it from your gitconfig:
#   [include] path = ~/.config/git/paris-catacombes.gitconfig

[color "diff"]
	meta = "#e7ecea bold"
	frag = "#709bc8"
	func = "#bfc8c2"
	old = "#e1837a"
	new = "#80c28e"
	commit = "#ebc168"
	whitespace = "normal #cd6b63"
	oldMoved = "#d0914f bold"
	oldMovedAlternative = "#709bc8 bold"
	newMoved = "#6ca087 bold"
	newMovedAlternative = "#ebc168 bold"
	oldMovedDimmed = "#708178"
	oldMovedAlternativeDimmed = "#708178 italic"
	newMovedDimmed = "#708178"
	newMovedAlternativeDimmed = "#708178 italic"
	contextDimmed = "#708178"
	oldDimmed = "#e1837a dim"
	newDimmed = "#80c28e dim"
	contextBold = "#e7ecea bold"
	oldBold = "#e1837a bold"
	newBold = "#80c28e bold"

[color "diff-highlight"]
	oldNormal = "#e1837a"
	oldHighlight = "#e1837a #58342f"
	newNormal = "#80c28e"
	newHighlight = "#80c28e #324d39"

[color "status"]
	header = "#bfc8c2"
	added = "#80c28e"
	changed = "#e1837a"
	untracked = "#ce96b4"
	branch = "#80c28e bold"
	nobranch = "#e1837a bold"
	localBranch = "#80c28e"
	remoteBranch = "#e1837a"
	unmerged = "#e1837a bold"

[color "branch"]
	current = "#80c28e bold"
	local = "#d4ddd7"
	remote = "#e1837a"
	upstream = "#709bc8"
	plain = "#bfc8c2"
	worktree = "#6ca087"

[color "decorate"]
	HEAD = "#6ca087 bold"
	branch = "#80c28e bold"
	remoteBranch = "#e1837a bold"
	tag = "#ebc168 bold"
	stash = "#d0914f bold"
	grafted = "#709bc8 bold"

[color "grep"]
	context = "#a5b1aa"
	filename = "#d0914f"
	function = "#ebc168"
	lineNumber = "#80c28e"
	column = "#80c28e"
	selected = "#d4ddd7"
	separator = "#708178"

[color "interactive"]
	prompt = "#d0914f bold"
	header = "#e7ecea bold"
	help = "#ebc168"
	error = "#e1837a bold"

[color "blame"]
	highlightRecent = "#708178,12 month ago,#bfc8c2,1 month ago,#d0914f"
	repeatedLines = "#708178"

[color "advice"]
	hint = "#ebc168"

[color "push"]
	error = "#e1837a"

[color "transport"]
	rejected = "#e1837a"

[color "remote"]
	hint = "#ebc168"
	warning = "#ebc168 bold"
	success = "#80c28e bold"
	error = "#e1837a bold"
