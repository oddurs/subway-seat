# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Catacombes for Git. Include it from your gitconfig:
#   [include] path = ~/.config/git/paris-catacombes.gitconfig

[color "diff"]
	meta = "#e8ecea bold"
	frag = "#709bc8"
	func = "#c0c7c3"
	old = "#e1837a"
	new = "#80c28e"
	commit = "#ebc168"
	whitespace = "normal #cd6b63"
	oldMoved = "#d0914f bold"
	oldMovedAlternative = "#709bc8 bold"
	newMoved = "#7bb096 bold"
	newMovedAlternative = "#ebc168 bold"
	oldMovedDimmed = "#738079"
	oldMovedAlternativeDimmed = "#738079 italic"
	newMovedDimmed = "#738079"
	newMovedAlternativeDimmed = "#738079 italic"
	contextDimmed = "#738079"
	oldDimmed = "#e1837a dim"
	newDimmed = "#80c28e dim"
	contextBold = "#e8ecea bold"
	oldBold = "#e1837a bold"
	newBold = "#80c28e bold"

[color "diff-highlight"]
	oldNormal = "#e1837a"
	oldHighlight = "#e1837a #59342f"
	newNormal = "#80c28e"
	newHighlight = "#80c28e #334d39"

[color "status"]
	header = "#c0c7c3"
	added = "#80c28e"
	changed = "#e1837a"
	untracked = "#ce96b4"
	branch = "#80c28e bold"
	nobranch = "#e1837a bold"
	localBranch = "#80c28e"
	remoteBranch = "#e1837a"
	unmerged = "#e1837a bold"

[color "branch"]
	current = "#80c28e bold"
	local = "#d5dcd8"
	remote = "#e1837a"
	upstream = "#709bc8"
	plain = "#c0c7c3"
	worktree = "#7bb096"

[color "decorate"]
	HEAD = "#7bb096 bold"
	branch = "#80c28e bold"
	remoteBranch = "#e1837a bold"
	tag = "#ebc168 bold"
	stash = "#d0914f bold"
	grafted = "#709bc8 bold"

[color "grep"]
	context = "#a7b0ab"
	filename = "#d0914f"
	function = "#ebc168"
	lineNumber = "#80c28e"
	column = "#80c28e"
	selected = "#d5dcd8"
	separator = "#738079"

[color "interactive"]
	prompt = "#d0914f bold"
	header = "#e8ecea bold"
	help = "#ebc168"
	error = "#e1837a bold"

[color "blame"]
	highlightRecent = "#738079,12 month ago,#c0c7c3,1 month ago,#d0914f"
	repeatedLines = "#738079"

[color "advice"]
	hint = "#ebc168"

[color "push"]
	error = "#e1837a"

[color "transport"]
	rejected = "#e1837a"

[color "remote"]
	hint = "#ebc168"
	warning = "#ebc168 bold"
	success = "#80c28e bold"
	error = "#e1837a bold"
