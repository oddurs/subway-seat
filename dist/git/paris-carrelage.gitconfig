# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Carrelage for Git. Include it from your gitconfig:
#   [include] path = ~/.config/git/paris-carrelage.gitconfig

[color "diff"]
	meta = "#1b221c bold"
	frag = "#27629c"
	func = "#3d473e"
	old = "#be423d"
	new = "#207f41"
	commit = "#8e6b08"
	whitespace = "normal #932d29"
	oldMoved = "#804b00 bold"
	oldMovedAlternative = "#27629c bold"
	newMoved = "#006e6b bold"
	newMovedAlternative = "#8e6b08 bold"
	oldMovedDimmed = "#6e7c6e"
	oldMovedAlternativeDimmed = "#6e7c6e italic"
	newMovedDimmed = "#6e7c6e"
	newMovedAlternativeDimmed = "#6e7c6e italic"
	contextDimmed = "#6e7c6e"
	oldDimmed = "#be423d dim"
	newDimmed = "#207f41 dim"
	contextBold = "#1b221c bold"
	oldBold = "#be423d bold"
	newBold = "#207f41 bold"

[color "diff-highlight"]
	oldNormal = "#be423d"
	oldHighlight = "#be423d #dcbcbb"
	newNormal = "#207f41"
	newHighlight = "#207f41 #a6ccb3"

[color "status"]
	header = "#3d473e"
	added = "#207f41"
	changed = "#be423d"
	untracked = "#98547c"
	branch = "#207f41 bold"
	nobranch = "#be423d bold"
	localBranch = "#207f41"
	remoteBranch = "#be423d"
	unmerged = "#be423d bold"

[color "branch"]
	current = "#207f41 bold"
	local = "#2a342b"
	remote = "#be423d"
	upstream = "#27629c"
	plain = "#3d473e"
	worktree = "#006e6b"

[color "decorate"]
	HEAD = "#006e6b bold"
	branch = "#207f41 bold"
	remoteBranch = "#be423d bold"
	tag = "#8e6b08 bold"
	stash = "#804b00 bold"
	grafted = "#27629c bold"

[color "grep"]
	context = "#4c574d"
	filename = "#804b00"
	function = "#8e6b08"
	lineNumber = "#207f41"
	column = "#207f41"
	selected = "#2a342b"
	separator = "#6e7c6e"

[color "interactive"]
	prompt = "#804b00 bold"
	header = "#1b221c bold"
	help = "#8e6b08"
	error = "#be423d bold"

[color "blame"]
	highlightRecent = "#6e7c6e,12 month ago,#3d473e,1 month ago,#804b00"
	repeatedLines = "#6e7c6e"

[color "advice"]
	hint = "#8e6b08"

[color "push"]
	error = "#be423d"

[color "transport"]
	rejected = "#be423d"

[color "remote"]
	hint = "#8e6b08"
	warning = "#8e6b08 bold"
	success = "#207f41 bold"
	error = "#be423d bold"
