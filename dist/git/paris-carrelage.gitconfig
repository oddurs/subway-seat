# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Carrelage for Git. Include it from your gitconfig:
#   [include] path = ~/.config/git/paris-carrelage.gitconfig

[color "diff"]
	meta = "#18231d bold"
	frag = "#27629c"
	func = "#374940"
	old = "#bb403b"
	new = "#18803f"
	commit = "#8a6700"
	whitespace = "normal #9e171b"
	oldMoved = "#9b5d00 bold"
	oldMovedAlternative = "#27629c bold"
	newMoved = "#277555 bold"
	newMovedAlternative = "#8a6700 bold"
	oldMovedDimmed = "#627f70"
	oldMovedAlternativeDimmed = "#627f70 italic"
	newMovedDimmed = "#627f70"
	newMovedAlternativeDimmed = "#627f70 italic"
	contextDimmed = "#627f70"
	oldDimmed = "#bb403b dim"
	newDimmed = "#18803f dim"
	contextBold = "#18231d bold"
	oldBold = "#bb403b bold"
	newBold = "#18803f bold"

[color "diff-highlight"]
	oldNormal = "#bb403b"
	oldHighlight = "#bb403b #e0b5b6"
	newNormal = "#18803f"
	newHighlight = "#18803f #a3ccb2"

[color "status"]
	header = "#374940"
	added = "#18803f"
	changed = "#bb403b"
	untracked = "#9a557d"
	branch = "#18803f bold"
	nobranch = "#bb403b bold"
	localBranch = "#18803f"
	remoteBranch = "#bb403b"
	unmerged = "#bb403b bold"

[color "branch"]
	current = "#18803f bold"
	local = "#25352c"
	remote = "#bb403b"
	upstream = "#27629c"
	plain = "#374940"
	worktree = "#277555"

[color "decorate"]
	HEAD = "#277555 bold"
	branch = "#18803f bold"
	remoteBranch = "#bb403b bold"
	tag = "#8a6700 bold"
	stash = "#9b5d00 bold"
	grafted = "#27629c bold"

[color "grep"]
	context = "#45594f"
	filename = "#9b5d00"
	function = "#8a6700"
	lineNumber = "#18803f"
	column = "#18803f"
	selected = "#25352c"
	separator = "#627f70"

[color "interactive"]
	prompt = "#9b5d00 bold"
	header = "#18231d bold"
	help = "#8a6700"
	error = "#bb403b bold"

[color "blame"]
	highlightRecent = "#627f70,12 month ago,#374940,1 month ago,#9b5d00"
	repeatedLines = "#627f70"

[color "advice"]
	hint = "#8a6700"

[color "push"]
	error = "#bb403b"

[color "transport"]
	rejected = "#bb403b"

[color "remote"]
	hint = "#8a6700"
	warning = "#8a6700 bold"
	success = "#18803f bold"
	error = "#bb403b bold"
