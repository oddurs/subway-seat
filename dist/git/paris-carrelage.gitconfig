# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Carrelage for Git. Include it from your gitconfig:
#   [include] path = ~/.config/git/paris-carrelage.gitconfig

[color "diff"]
	meta = "#1b221c bold"
	frag = "#27629c"
	func = "#3d473e"
	old = "#bb403b"
	new = "#207f41"
	commit = "#8a6700"
	whitespace = "normal #932d29"
	oldMoved = "#8a5308 bold"
	oldMovedAlternative = "#27629c bold"
	newMoved = "#0b714d bold"
	newMovedAlternative = "#8a6700 bold"
	oldMovedDimmed = "#6e7c6e"
	oldMovedAlternativeDimmed = "#6e7c6e italic"
	newMovedDimmed = "#6e7c6e"
	newMovedAlternativeDimmed = "#6e7c6e italic"
	contextDimmed = "#6e7c6e"
	oldDimmed = "#bb403b dim"
	newDimmed = "#207f41 dim"
	contextBold = "#1b221c bold"
	oldBold = "#bb403b bold"
	newBold = "#207f41 bold"

[color "diff-highlight"]
	oldNormal = "#bb403b"
	oldHighlight = "#bb403b #dcbcbb"
	newNormal = "#207f41"
	newHighlight = "#207f41 #a6ccb3"

[color "status"]
	header = "#3d473e"
	added = "#207f41"
	changed = "#bb403b"
	untracked = "#9a557d"
	branch = "#207f41 bold"
	nobranch = "#bb403b bold"
	localBranch = "#207f41"
	remoteBranch = "#bb403b"
	unmerged = "#bb403b bold"

[color "branch"]
	current = "#207f41 bold"
	local = "#2a342b"
	remote = "#bb403b"
	upstream = "#27629c"
	plain = "#3d473e"
	worktree = "#0b714d"

[color "decorate"]
	HEAD = "#0b714d bold"
	branch = "#207f41 bold"
	remoteBranch = "#bb403b bold"
	tag = "#8a6700 bold"
	stash = "#8a5308 bold"
	grafted = "#27629c bold"

[color "grep"]
	context = "#4c574d"
	filename = "#8a5308"
	function = "#8a6700"
	lineNumber = "#207f41"
	column = "#207f41"
	selected = "#2a342b"
	separator = "#6e7c6e"

[color "interactive"]
	prompt = "#8a5308 bold"
	header = "#1b221c bold"
	help = "#8a6700"
	error = "#bb403b bold"

[color "blame"]
	highlightRecent = "#6e7c6e,12 month ago,#3d473e,1 month ago,#8a5308"
	repeatedLines = "#6e7c6e"

[color "advice"]
	hint = "#8a6700"

[color "push"]
	error = "#bb403b"

[color "transport"]
	rejected = "#bb403b"

[color "remote"]
	hint = "#8a6700"
	warning = "#8a6700 bold"
	success = "#207f41 bold"
	error = "#bb403b bold"
