# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Carrelage for Git. Include it from your gitconfig:
#   [include] path = ~/.config/git/paris-carrelage.gitconfig

[color "diff"]
	meta = "#18231d bold"
	frag = "#27629c"
	func = "#374940"
	old = "#bb403b"
	new = "#207f41"
	commit = "#8a6700"
	whitespace = "normal #932d29"
	oldMoved = "#754500 bold"
	oldMovedAlternative = "#27629c bold"
	newMoved = "#086142 bold"
	newMovedAlternative = "#8a6700 bold"
	oldMovedDimmed = "#627f70"
	oldMovedAlternativeDimmed = "#627f70 italic"
	newMovedDimmed = "#627f70"
	newMovedAlternativeDimmed = "#627f70 italic"
	contextDimmed = "#627f70"
	oldDimmed = "#bb403b dim"
	newDimmed = "#207f41 dim"
	contextBold = "#18231d bold"
	oldBold = "#bb403b bold"
	newBold = "#207f41 bold"

[color "diff-highlight"]
	oldNormal = "#bb403b"
	oldHighlight = "#bb403b #dcbcbb"
	newNormal = "#207f41"
	newHighlight = "#207f41 #a6ccb3"

[color "status"]
	header = "#374940"
	added = "#207f41"
	changed = "#bb403b"
	untracked = "#9a557d"
	branch = "#207f41 bold"
	nobranch = "#bb403b bold"
	localBranch = "#207f41"
	remoteBranch = "#bb403b"
	unmerged = "#bb403b bold"

[color "branch"]
	current = "#207f41 bold"
	local = "#25352c"
	remote = "#bb403b"
	upstream = "#27629c"
	plain = "#374940"
	worktree = "#086142"

[color "decorate"]
	HEAD = "#086142 bold"
	branch = "#207f41 bold"
	remoteBranch = "#bb403b bold"
	tag = "#8a6700 bold"
	stash = "#754500 bold"
	grafted = "#27629c bold"

[color "grep"]
	context = "#45594f"
	filename = "#754500"
	function = "#8a6700"
	lineNumber = "#207f41"
	column = "#207f41"
	selected = "#25352c"
	separator = "#627f70"

[color "interactive"]
	prompt = "#754500 bold"
	header = "#18231d bold"
	help = "#8a6700"
	error = "#bb403b bold"

[color "blame"]
	highlightRecent = "#627f70,12 month ago,#374940,1 month ago,#754500"
	repeatedLines = "#627f70"

[color "advice"]
	hint = "#8a6700"

[color "push"]
	error = "#bb403b"

[color "transport"]
	rejected = "#bb403b"

[color "remote"]
	hint = "#8a6700"
	warning = "#8a6700 bold"
	success = "#207f41 bold"
	error = "#bb403b bold"
