{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#D3E2DB",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#A2B7AE",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#EBC342",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#0A1D15",
    "background_color": "#D78E3C",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#D78E3C"
  },
  "h3": {
    "prefix": "### ",
    "color": "#EBC342"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#73C686"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#6FB393"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#A2B7AE",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "color": "#E6F0EB",
    "bold": true
  },
  "hr": {
    "color": "#285A47",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#639BD5",
    "underline": true
  },
  "link_text": {
    "color": "#82B7EE",
    "bold": true
  },
  "image": {
    "color": "#639BD5",
    "underline": true
  },
  "image_text": {
    "color": "#6FB393",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#73C686",
    "background_color": "#113E2E"
  },
  "code_block": {
    "color": "#D3E2DB",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#D3E2DB"
      },
      "error": {
        "color": "#0A1D15",
        "background_color": "#EF796F"
      },
      "comment": {
        "color": "#67897A",
        "italic": true
      },
      "comment_preproc": {
        "color": "#E783BD",
        "italic": true
      },
      "keyword": {
        "color": "#D78E3C"
      },
      "keyword_reserved": {
        "color": "#D78E3C"
      },
      "keyword_namespace": {
        "color": "#D78E3C"
      },
      "keyword_type": {
        "color": "#6FB393",
        "italic": true
      },
      "operator": {
        "color": "#86A195"
      },
      "punctuation": {
        "color": "#86A195"
      },
      "name": {
        "color": "#D3E2DB"
      },
      "name_builtin": {
        "color": "#EBC342",
        "italic": true
      },
      "name_tag": {
        "color": "#D78E3C"
      },
      "name_attribute": {
        "color": "#EBC342",
        "italic": true
      },
      "name_class": {
        "color": "#6FB393"
      },
      "name_constant": {
        "color": "#EF796F"
      },
      "name_decorator": {
        "color": "#E783BD",
        "italic": true
      },
      "name_exception": {
        "color": "#6FB393"
      },
      "name_function": {
        "color": "#EBC342"
      },
      "name_other": {
        "color": "#D3E2DB"
      },
      "literal": {
        "color": "#EF796F"
      },
      "literal_number": {
        "color": "#EF796F"
      },
      "literal_date": {
        "color": "#EF796F"
      },
      "literal_string": {
        "color": "#73C686"
      },
      "literal_string_escape": {
        "color": "#E783BD"
      },
      "generic_deleted": {
        "color": "#EF796F"
      },
      "generic_emph": {
        "color": "#D3E2DB",
        "italic": true
      },
      "generic_inserted": {
        "color": "#73C686"
      },
      "generic_strong": {
        "color": "#E6F0EB",
        "bold": true
      },
      "generic_subheading": {
        "color": "#639BD5"
      },
      "background": {
        "background_color": "#0C261C"
      }
    }
  },
  "table": {
    "color": "#86A195",
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#EBC342"
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
