{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#2A342B",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#4C574D",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#8E6B08",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#EEF3ED",
    "background_color": "#804B00",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#804B00"
  },
  "h3": {
    "prefix": "### ",
    "color": "#8E6B08"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#207F41"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#006E6B"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#4C574D",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "color": "#1B221C",
    "bold": true
  },
  "hr": {
    "color": "#9BAC9A",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#27629C",
    "underline": true
  },
  "link_text": {
    "color": "#3E75AD",
    "bold": true
  },
  "image": {
    "color": "#27629C",
    "underline": true
  },
  "image_text": {
    "color": "#006E6B",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#207F41",
    "background_color": "#E1E7E0"
  },
  "code_block": {
    "color": "#2A342B",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#2A342B"
      },
      "error": {
        "color": "#EEF3ED",
        "background_color": "#BE423D"
      },
      "comment": {
        "color": "#6E7C6E",
        "italic": true
      },
      "comment_preproc": {
        "color": "#98547C",
        "italic": true
      },
      "keyword": {
        "color": "#804B00"
      },
      "keyword_reserved": {
        "color": "#804B00"
      },
      "keyword_namespace": {
        "color": "#804B00"
      },
      "keyword_type": {
        "color": "#006E6B",
        "italic": true
      },
      "operator": {
        "color": "#586459"
      },
      "punctuation": {
        "color": "#586459"
      },
      "name": {
        "color": "#2A342B"
      },
      "name_builtin": {
        "color": "#8E6B08",
        "italic": true
      },
      "name_tag": {
        "color": "#804B00"
      },
      "name_attribute": {
        "color": "#8E6B08",
        "italic": true
      },
      "name_class": {
        "color": "#006E6B"
      },
      "name_constant": {
        "color": "#BE423D"
      },
      "name_decorator": {
        "color": "#98547C",
        "italic": true
      },
      "name_exception": {
        "color": "#006E6B"
      },
      "name_function": {
        "color": "#8E6B08"
      },
      "name_other": {
        "color": "#2A342B"
      },
      "literal": {
        "color": "#BE423D"
      },
      "literal_number": {
        "color": "#BE423D"
      },
      "literal_date": {
        "color": "#BE423D"
      },
      "literal_string": {
        "color": "#207F41"
      },
      "literal_string_escape": {
        "color": "#98547C"
      },
      "generic_deleted": {
        "color": "#BE423D"
      },
      "generic_emph": {
        "color": "#2A342B",
        "italic": true
      },
      "generic_inserted": {
        "color": "#207F41"
      },
      "generic_strong": {
        "color": "#1B221C",
        "bold": true
      },
      "generic_subheading": {
        "color": "#27629C"
      },
      "background": {
        "background_color": "#E1E7E0"
      }
    }
  },
  "table": {
    "color": "#586459",
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#8E6B08"
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
