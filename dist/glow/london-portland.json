{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#2F3033",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#515459",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#896800",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#E5EAF6",
    "background_color": "#9F591B",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#9F591B"
  },
  "h3": {
    "prefix": "### ",
    "color": "#896800"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#357D41"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#007376"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#515459",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "color": "#1F2022",
    "bold": true
  },
  "hr": {
    "color": "#9BA5B8",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#0019A8",
    "underline": true
  },
  "link_text": {
    "color": "#406BD0",
    "bold": true
  },
  "image": {
    "color": "#0019A8",
    "underline": true
  },
  "image_text": {
    "color": "#007376",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#357D41",
    "background_color": "#D9E0EC"
  },
  "code_block": {
    "color": "#2F3033",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#2F3033"
      },
      "error": {
        "color": "#E5EAF6",
        "background_color": "#CA2822"
      },
      "comment": {
        "color": "#727781",
        "italic": true
      },
      "comment_preproc": {
        "color": "#7660AB",
        "italic": true
      },
      "keyword": {
        "color": "#9F591B"
      },
      "keyword_reserved": {
        "color": "#9F591B"
      },
      "keyword_namespace": {
        "color": "#9F591B"
      },
      "keyword_type": {
        "color": "#007376",
        "italic": true
      },
      "operator": {
        "color": "#5D6168"
      },
      "punctuation": {
        "color": "#5D6168"
      },
      "name": {
        "color": "#2F3033"
      },
      "name_builtin": {
        "color": "#896800",
        "italic": true
      },
      "name_tag": {
        "color": "#9F591B"
      },
      "name_attribute": {
        "color": "#896800",
        "italic": true
      },
      "name_class": {
        "color": "#007376"
      },
      "name_constant": {
        "color": "#CA2822"
      },
      "name_decorator": {
        "color": "#7660AB",
        "italic": true
      },
      "name_exception": {
        "color": "#007376"
      },
      "name_function": {
        "color": "#896800"
      },
      "name_other": {
        "color": "#2F3033"
      },
      "literal": {
        "color": "#CA2822"
      },
      "literal_number": {
        "color": "#CA2822"
      },
      "literal_date": {
        "color": "#CA2822"
      },
      "literal_string": {
        "color": "#357D41"
      },
      "literal_string_escape": {
        "color": "#7660AB"
      },
      "generic_deleted": {
        "color": "#CA2822"
      },
      "generic_emph": {
        "color": "#2F3033",
        "italic": true
      },
      "generic_inserted": {
        "color": "#357D41"
      },
      "generic_strong": {
        "color": "#1F2022",
        "bold": true
      },
      "generic_subheading": {
        "color": "#0019A8"
      },
      "background": {
        "background_color": "#D9E0EC"
      }
    }
  },
  "table": {
    "color": "#5D6168",
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#896800"
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
