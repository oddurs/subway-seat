# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Subway Seat Enamel for Newsboat. The colorN slots are Subway Seat Enamel's terminal palette,
# so run it in a terminal set to Subway Seat Enamel.

color background          default  default
color listnormal          default  default
color listfocus           default  color15 bold
color listnormal_unread   color3   default bold
color listfocus_unread    color3   color15 bold
color title               color5   default bold
color info                color0   color15
color hint-key            color3   color15 bold
color hint-keys-delimiter color8   color15
color hint-separator      color8   color15
color hint-description    color0   color15
color article             default  default
color end-of-text-marker  color8   default

highlight article "^(Feed|Title|Author|Link|Date|Podcast Download URL|Flags):" color5 default bold
highlight article "https?://[^ ]+" color4 default underline
highlight article "\\[[0-9]+\\]" color6 default bold
highlight article "\\((link|image|video|embedded flash|audio)\\)" color8 default
