// Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
// Paris Catacombes: legacy color-list theme for Zellij before 0.42.

themes {
    paris-catacombes {
        fg "#D4DDD7"
        bg "#24342C"
        black "#0D1711"
        red "#E1837A"
        green "#D0914F" // active frame, selected tab
        yellow "#F2BF4B"
        blue "#709BC8"
        magenta "#CE96B4"
        orange "#F2BF4B" // frame in other modes
        cyan "#6CA087"
        white "#E7ECEA"
    }
}
