// Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
// Paris Catacombes: legacy color-list theme for Zellij before 0.42.

themes {
    paris-catacombes {
        fg "#CFDED7"
        bg "#13382A"
        black "#061811"
        red "#EF796F"
        green "#D78E3C" // active frame, selected tab
        yellow "#EBC342"
        blue "#639BD5"
        magenta "#E783BD"
        orange "#EBC342" // frame in other modes
        cyan "#6FB393"
        white "#E4EEE9"
    }
}
