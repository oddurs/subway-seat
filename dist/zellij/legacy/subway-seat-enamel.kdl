// Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
// Subway Seat Enamel: legacy color-list theme for Zellij before 0.42.

themes {
    subway-seat-enamel {
        fg "#3E2C1E"
        bg "#CAB48E"
        black "#EBDEC6"
        red "#BC4031"
        green "#AD4E00" // active frame, selected tab
        yellow "#936200"
        blue "#3F6480"
        magenta "#A65633"
        orange "#936200" // frame in other modes
        cyan "#3E7157"
        white "#2A1D13"
    }
}
