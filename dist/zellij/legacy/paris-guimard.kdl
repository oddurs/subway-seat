// Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
// Paris Guimard: legacy color-list theme for Zellij before 0.42.

themes {
    paris-guimard {
        fg "#D9E1DB"
        bg "#30463B"
        black "#18241D"
        red "#E1837A"
        green "#D0914F" // active frame, selected tab
        yellow "#F2BF4B"
        blue "#709BC8"
        magenta "#CE96B4"
        orange "#F2BF4B" // frame in other modes
        cyan "#6CA087"
        white "#E9EEEC"
    }
}
