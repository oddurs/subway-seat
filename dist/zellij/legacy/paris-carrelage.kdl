// Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
// Paris Carrelage: legacy color-list theme for Zellij before 0.42.

themes {
    paris-carrelage {
        fg "#2A342B"
        bg "#B1C0B0"
        black "#E1E7E0"
        red "#BB403B"
        green "#8A5308" // active frame, selected tab
        yellow "#8A6700"
        blue "#27629C"
        magenta "#9A557D"
        orange "#8A6700" // frame in other modes
        cyan "#0B714D"
        white "#1B221C"
    }
}
