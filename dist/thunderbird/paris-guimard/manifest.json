{
  "manifest_version": 2,
  "name": "Paris Guimard",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Cast iron off a Metro entrance, which is nearly black. Brass leads.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "paris-guimard-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#141A17",
      "frame_inactive": "#141A17",
      "tab_background_text": "#929D97",
      "tab_background_separator": "#2A3831",
      "tab_selected": "#212D27",
      "tab_text": "#DAE0DC",
      "tab_line": "#D0914F",
      "tab_loading": "#D0914F",
      "toolbar": "#212D27",
      "toolbar_text": "#DAE0DC",
      "toolbar_top_separator": "#141A17",
      "toolbar_bottom_separator": "#2A3831",
      "toolbar_vertical_separator": "#2A3831",
      "icons": "#C3CAC6",
      "icons_attention": "#D0914F",
      "button_background_hover": "#2A3831",
      "button_background_active": "#34453C",
      "toolbar_field": "#1A231E",
      "toolbar_field_text": "#DAE0DC",
      "toolbar_field_border": "#2A3831",
      "toolbar_field_focus": "#1A231E",
      "toolbar_field_text_focus": "#EAEEEC",
      "toolbar_field_border_focus": "#D0914F",
      "toolbar_field_highlight": "#42544B",
      "toolbar_field_highlight_text": "#EAEEEC",
      "toolbar_field_separator": "#2A3831",
      "popup": "#2A3831",
      "popup_text": "#DAE0DC",
      "popup_border": "#3F4C46",
      "popup_highlight": "#42544B",
      "popup_highlight_text": "#EAEEEC",
      "sidebar": "#1A231E",
      "sidebar_text": "#DAE0DC",
      "sidebar_border": "#2A3831",
      "sidebar_highlight": "#42544B",
      "sidebar_highlight_text": "#EAEEEC",
      "ntp_background": "#212D27",
      "ntp_card_background": "#2A3831",
      "ntp_text": "#DAE0DC",
      "spaces_bg": "#141A17",
      "spaces_bg_active": "#D0914F",
      "spaces_button": "#141A17",
      "tree_view_bg": "#212D27",
      "button_primary_bg": "#D0914F",
      "button_text": "#141A17",
      "tree_pane_bg": "#1A231E",
      "tree_card_bg": "#212D27",
      "button_bg": "#2A3831",
      "list_container_background_selected_current": "#42544B",
      "calendar_view_toggle_bg": "#1A231E",
      "calendar_view_toggle_hover_bg": "#2A3831",
      "tabs_toolbar_bg": "#141A17",
      "lwt_accent_color": "#141A17",
      "layout_bg_0": "#212D27",
      "layout_bg_1": "#1A231E",
      "layout_bg_2": "#1A231E",
      "layout_bg_3": "#2A3831",
      "layout_bg_4": "#34453C",
      "layout_color_0": "#EAEEEC",
      "layout_color_1": "#DAE0DC",
      "layout_color_2": "#C3CAC6",
      "layout_color_3": "#929D97",
      "layout_border_0": "#2A3831",
      "layout_border_1": "#34453C",
      "layout_border_2": "#5B6A62"
