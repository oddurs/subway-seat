      "tabs_toolbar_bg": "#0A1D15",
      "lwt_accent_color": "#0A1D15",
      "layout_bg_0": "#0E3125",
      "layout_bg_1": "#0C261C",
      "layout_bg_2": "#0C261C",
      "layout_bg_3": "#113E2E",
      "layout_bg_4": "#194A39",
      "layout_color_0": "#E6F0EB",
      "layout_color_1": "#D3E2DB",
