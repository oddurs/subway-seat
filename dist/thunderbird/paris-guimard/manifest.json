      "toolbar_field_highlight": "#3E554A",
      "toolbar_field_highlight_text": "#E9EEEC",
      "toolbar_field_separator": "#263930",
      "popup": "#263930",
      "popup_text": "#D9E1DB",
      "popup_border": "#3C4D45",
      "popup_highlight": "#3E554A",
      "popup_highlight_text": "#E9EEEC",
      "sidebar": "#18241D",
      "sidebar_text": "#D9E1DB",
      "sidebar_border": "#263930",
      "sidebar_highlight": "#3E554A",
      "sidebar_highlight_text": "#E9EEEC",
