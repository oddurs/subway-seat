{
  "manifest_version": 2,
  "name": "London Moquette",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. The seat you're sitting on. Corporate Blue, turned right down.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "london-moquette-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#121826",
      "frame_inactive": "#121826",
      "tab_background_text": "#8F9AB0",
      "tab_background_separator": "#263451",
      "tab_selected": "#1E2941",
      "tab_text": "#D8DEEA",
      "tab_line": "#DE8946",
      "tab_loading": "#DE8946",
      "toolbar": "#1E2941",
      "toolbar_text": "#D8DEEA",
      "toolbar_top_separator": "#121826",
      "toolbar_bottom_separator": "#263451",
      "toolbar_vertical_separator": "#263451",
      "icons": "#C1C9D8",
      "icons_attention": "#DE8946",
      "button_background_hover": "#263451",
      "button_background_active": "#303F61",
      "toolbar_field": "#172032",
      "toolbar_field_text": "#D8DEEA",
      "toolbar_field_border": "#263451",
      "toolbar_field_focus": "#172032",
      "toolbar_field_text_focus": "#E9EDF5",
      "toolbar_field_border_focus": "#DE8946",
      "toolbar_field_highlight": "#3D4F72",
      "toolbar_field_highlight_text": "#E9EDF5",
      "toolbar_field_separator": "#263451",
      "popup": "#263451",
      "popup_text": "#D8DEEA",
      "popup_border": "#3C4964",
      "popup_highlight": "#3D4F72",
      "popup_highlight_text": "#E9EDF5",
      "sidebar": "#172032",
      "sidebar_text": "#D8DEEA",
      "sidebar_border": "#263451",
      "sidebar_highlight": "#3D4F72",
      "sidebar_highlight_text": "#E9EDF5",
      "ntp_background": "#1E2941",
      "ntp_card_background": "#263451",
      "ntp_text": "#D8DEEA",
      "spaces_bg": "#121826",
      "spaces_bg_active": "#DE8946",
      "spaces_button": "#121826",
      "tree_view_bg": "#1E2941",
      "button_primary_bg": "#DE8946",
      "button_text": "#121826",
      "tree_pane_bg": "#172032",
      "tree_card_bg": "#1E2941",
      "button_bg": "#263451",
      "list_container_background_selected_current": "#3D4F72",
      "calendar_view_toggle_bg": "#172032",
      "calendar_view_toggle_hover_bg": "#263451",
      "tabs_toolbar_bg": "#121826",
      "lwt_accent_color": "#121826",
      "layout_bg_0": "#1E2941",
      "layout_bg_1": "#172032",
      "layout_bg_2": "#172032",
      "layout_bg_3": "#263451",
      "layout_bg_4": "#303F61",
      "layout_color_0": "#E9EDF5",
      "layout_color_1": "#D8DEEA",
      "layout_color_2": "#C1C9D8",
      "layout_color_3": "#8F9AB0",
      "layout_border_0": "#263451",
      "layout_border_1": "#303F61",
      "layout_border_2": "#576685"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
