{
  "manifest_version": 2,
  "name": "London Portland",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Holden's Portland stone. Links are the exact Corporate Blue.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "london-portland-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#CDD5E4",
      "frame_inactive": "#DAE0EB",
      "tab_background_text": "#556179",
      "tab_background_separator": "#A9B7D4",
      "tab_selected": "#E5EAF4",
      "tab_text": "#293040",
      "tab_line": "#A45600",
      "tab_loading": "#A45600",
      "toolbar": "#E5EAF4",
      "toolbar_text": "#293040",
      "toolbar_top_separator": "#CDD5E4",
      "toolbar_bottom_separator": "#A9B7D4",
      "toolbar_vertical_separator": "#A9B7D4",
      "icons": "#3C4557",
      "icons_attention": "#A45600",
      "button_background_hover": "#BFCAE1",
      "button_background_active": "#A9B7D4",
      "toolbar_field": "#DAE0EB",
      "toolbar_field_text": "#293040",
      "toolbar_field_border": "#A9B7D4",
      "toolbar_field_focus": "#E5EAF4",
      "toolbar_field_text_focus": "#1B202B",
      "toolbar_field_border_focus": "#A45600",
      "toolbar_field_highlight": "#A9B7D4",
      "toolbar_field_highlight_text": "#1B202B",
      "toolbar_field_separator": "#A9B7D4",
      "popup": "#F2F4FA",
      "popup_text": "#293040",
      "popup_border": "#D6D8E0",
      "popup_highlight": "#A9B7D4",
      "popup_highlight_text": "#1B202B",
      "sidebar": "#DAE0EB",
      "sidebar_text": "#293040",
      "sidebar_border": "#A9B7D4",
      "sidebar_highlight": "#A9B7D4",
      "sidebar_highlight_text": "#1B202B",
      "ntp_background": "#E5EAF4",
      "ntp_card_background": "#DAE0EB",
      "ntp_text": "#293040",
      "spaces_bg": "#CDD5E4",
      "spaces_bg_active": "#A45600",
      "spaces_button": "#E5EAF4",
      "tree_view_bg": "#E5EAF4",
      "button_primary_bg": "#A45600",
      "button_text": "#E5EAF4",
      "tree_pane_bg": "#DAE0EB",
      "tree_card_bg": "#E5EAF4",
      "button_bg": "#DAE0EB",
      "list_container_background_selected_current": "#A9B7D4",
      "calendar_view_toggle_bg": "#DAE0EB",
      "calendar_view_toggle_hover_bg": "#BFCAE1",
      "tabs_toolbar_bg": "#CDD5E4",
      "lwt_accent_color": "#CDD5E4",
      "layout_bg_0": "#E5EAF4",
      "layout_bg_1": "#DAE0EB",
      "layout_bg_2": "#DAE0EB",
      "layout_bg_3": "#F2F4FA",
      "layout_bg_4": "#BFCAE1",
      "layout_color_0": "#1B202B",
      "layout_color_1": "#293040",
      "layout_color_2": "#3C4557",
      "layout_color_3": "#556179",
      "layout_border_0": "#A9B7D4",
      "layout_border_1": "#95A5C4",
      "layout_border_2": "#8291AE"
