{
  "manifest_version": 2,
  "name": "London Portland",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Holden's Portland stone. Links are the exact Corporate Blue.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "london-portland-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#CED5E3",
      "frame_inactive": "#D9E0EC",
      "tab_background_text": "#5D6168",
      "tab_background_separator": "#ADB7CB",
      "tab_selected": "#E5EAF6",
      "tab_text": "#2F3033",
      "tab_line": "#9F591B",
      "tab_loading": "#9F591B",
      "toolbar": "#E5EAF6",
      "toolbar_text": "#2F3033",
      "toolbar_top_separator": "#CED5E3",
      "toolbar_bottom_separator": "#ADB7CB",
      "toolbar_vertical_separator": "#ADB7CB",
      "icons": "#434548",
      "icons_attention": "#9F591B",
      "button_background_hover": "#C1CADC",
      "button_background_active": "#ADB7CB",
      "toolbar_field": "#D9E0EC",
      "toolbar_field_text": "#2F3033",
      "toolbar_field_border": "#ADB7CB",
      "toolbar_field_focus": "#E5EAF6",
      "toolbar_field_text_focus": "#1F2022",
      "toolbar_field_border_focus": "#9F591B",
      "toolbar_field_highlight": "#ADB7CB",
      "toolbar_field_highlight_text": "#1F2022",
      "toolbar_field_separator": "#ADB7CB",
      "popup": "#F2F4FA",
      "popup_text": "#2F3033",
      "popup_border": "#D6D8DE",
      "popup_highlight": "#ADB7CB",
      "popup_highlight_text": "#1F2022",
      "sidebar": "#D9E0EC",
      "sidebar_text": "#2F3033",
      "sidebar_border": "#ADB7CB",
      "sidebar_highlight": "#ADB7CB",
      "sidebar_highlight_text": "#1F2022",
      "ntp_background": "#E5EAF6",
      "ntp_card_background": "#D9E0EC",
      "ntp_text": "#2F3033",
      "spaces_bg": "#CED5E3",
      "spaces_bg_active": "#9F591B",
      "spaces_button": "#E5EAF6",
      "tree_view_bg": "#E5EAF6",
      "button_primary_bg": "#9F591B",
      "button_text": "#E5EAF6",
      "tree_pane_bg": "#D9E0EC",
      "tree_card_bg": "#E5EAF6",
      "button_bg": "#D9E0EC",
      "list_container_background_selected_current": "#ADB7CB",
      "calendar_view_toggle_bg": "#D9E0EC",
      "calendar_view_toggle_hover_bg": "#C1CADC",
      "tabs_toolbar_bg": "#CED5E3",
      "lwt_accent_color": "#CED5E3",
      "layout_bg_0": "#E5EAF6",
      "layout_bg_1": "#D9E0EC",
      "layout_bg_2": "#D9E0EC",
      "layout_bg_3": "#F2F4FA",
      "layout_bg_4": "#C1CADC",
      "layout_color_0": "#1F2022",
      "layout_color_1": "#2F3033",
      "layout_color_2": "#434548",
      "layout_color_3": "#5D6168",
      "layout_border_0": "#ADB7CB",
      "layout_border_1": "#9BA5B8",
      "layout_border_2": "#8A919F"
