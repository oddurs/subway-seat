{
  "manifest_version": 2,
  "name": "Subway Seat Tunnel",
  "version": "0.2.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. The late local after midnight: espresso-deep, same warm lights. (Subway Seat \u2014 generated from palette.py by build.py. Edit the palette, not this file.)",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "subway-seat-tunnel-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "bg_color": "--bg-color",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color"
    }
  },
  "theme": {
    "colors": {
      "frame": "#140D07",
      "frame_inactive": "#140D07",
      "tab_background_text": "#A48B6C",
      "tab_background_separator": "#302115",
      "tab_selected": "#24180E",
      "tab_text": "#E9D8B6",
      "tab_line": "#EC7F31",
      "tab_loading": "#EC7F31",
      "toolbar": "#24180E",
      "toolbar_text": "#E9D8B6",
      "toolbar_top_separator": "#140D07",
      "toolbar_bottom_separator": "#302115",
      "toolbar_vertical_separator": "#302115",
      "icons": "#D6C3A0",
      "icons_attention": "#EC7F31",
      "button_background_hover": "#302115",
      "button_background_active": "#3D2C1D",
      "toolbar_field": "#1B120A",
      "toolbar_field_text": "#E9D8B6",
      "toolbar_field_border": "#302115",
      "toolbar_field_focus": "#1B120A",
      "toolbar_field_text_focus": "#F6EAD1",
      "toolbar_field_border_focus": "#EC7F31",
      "toolbar_field_highlight": "#4F3927",
      "toolbar_field_highlight_text": "#F6EAD1",
      "toolbar_field_separator": "#302115",
      "popup": "#1B120A",
      "popup_text": "#E9D8B6",
      "popup_border": "#302115",
      "popup_highlight": "#4F3927",
      "popup_highlight_text": "#F6EAD1",
      "sidebar": "#1B120A",
      "sidebar_text": "#E9D8B6",
      "sidebar_border": "#302115",
      "sidebar_highlight": "#4F3927",
      "sidebar_highlight_text": "#F6EAD1",
      "ntp_background": "#24180E",
      "ntp_card_background": "#302115",
      "ntp_text": "#E9D8B6",
      "spaces_bg": "#140D07",
      "spaces_bg_active": "#EC7F31",
      "spaces_button": "#140D07",
      "tree_view_bg": "#24180E",
      "bg_color": "#24180E",
      "button_primary_bg": "#EC7F31",
      "button_text": "#140D07",
      "tree_pane_bg": "#1B120A",
      "tree_card_bg": "#24180E",
      "layout_bg_0": "#24180E",
      "layout_bg_1": "#1B120A",
      "button_bg": "#302115",
      "list_container_background_selected_current": "#4F3927",
      "calendar_view_toggle_bg": "#1B120A",
      "calendar_view_toggle_hover_bg": "#302115",
      "tabs_toolbar_bg": "#140D07"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
