{
  "manifest_version": 2,
  "name": "Subway Seat",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Walnut paneling and orange bucket seats. The original.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "subway-seat-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#20160E",
      "frame_inactive": "#20160E",
      "tab_background_text": "#AE9575",
      "tab_background_separator": "#43301F",
      "tab_selected": "#362619",
      "tab_text": "#EDDCBC",
      "tab_line": "#EC7F31",
      "tab_loading": "#EC7F31",
      "toolbar": "#362619",
      "toolbar_text": "#EDDCBC",
      "toolbar_top_separator": "#20160E",
      "toolbar_bottom_separator": "#43301F",
      "toolbar_vertical_separator": "#43301F",
      "icons": "#D9C6A3",
      "icons_attention": "#EC7F31",
      "button_background_hover": "#43301F",
      "button_background_active": "#513B27",
      "toolbar_field": "#2A1D13",
      "toolbar_field_text": "#EDDCBC",
      "toolbar_field_border": "#43301F",
      "toolbar_field_focus": "#2A1D13",
      "toolbar_field_text_focus": "#F8ECD4",
      "toolbar_field_border_focus": "#EC7F31",
      "toolbar_field_highlight": "#634932",
      "toolbar_field_highlight_text": "#F8ECD4",
      "toolbar_field_separator": "#43301F",
      "popup": "#43301F",
      "popup_text": "#EDDCBC",
      "popup_border": "#584532",
      "popup_highlight": "#634932",
      "popup_highlight_text": "#F8ECD4",
      "sidebar": "#2A1D13",
      "sidebar_text": "#EDDCBC",
      "sidebar_border": "#43301F",
      "sidebar_highlight": "#634932",
      "sidebar_highlight_text": "#F8ECD4",
      "ntp_background": "#362619",
      "ntp_card_background": "#43301F",
      "ntp_text": "#EDDCBC",
      "spaces_bg": "#20160E",
      "spaces_bg_active": "#EC7F31",
      "spaces_button": "#20160E",
      "tree_view_bg": "#362619",
      "button_primary_bg": "#EC7F31",
      "button_text": "#20160E",
      "tree_pane_bg": "#2A1D13",
      "tree_card_bg": "#362619",
      "button_bg": "#43301F",
      "list_container_background_selected_current": "#634932",
      "calendar_view_toggle_bg": "#2A1D13",
      "calendar_view_toggle_hover_bg": "#43301F",
      "tabs_toolbar_bg": "#20160E",
      "lwt_accent_color": "#20160E",
      "layout_bg_0": "#362619",
      "layout_bg_1": "#2A1D13",
      "layout_bg_2": "#2A1D13",
      "layout_bg_3": "#43301F",
      "layout_bg_4": "#513B27",
      "layout_color_0": "#F8ECD4",
      "layout_color_1": "#EDDCBC",
      "layout_color_2": "#D9C6A3",
      "layout_color_3": "#AE9575",
      "layout_border_0": "#43301F",
      "layout_border_1": "#513B27",
      "layout_border_2": "#7B6047"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
