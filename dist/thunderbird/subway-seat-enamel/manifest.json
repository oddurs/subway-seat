{
  "manifest_version": 2,
  "name": "Subway Seat Enamel",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Cream enamel panels in the morning sun. The light one.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "subway-seat-enamel-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#E4D8C0",
      "frame_inactive": "#EEE4D0",
      "tab_background_text": "#735C44",
      "tab_background_separator": "#CBB898",
      "tab_selected": "#F8EFDF",
      "tab_text": "#3E2C1E",
      "tab_line": "#AD4E00",
      "tab_loading": "#AD4E00",
      "toolbar": "#F8EFDF",
      "toolbar_text": "#3E2C1E",
      "toolbar_top_separator": "#E4D8C0",
      "toolbar_bottom_separator": "#CBB898",
      "toolbar_vertical_separator": "#CBB898",
      "icons": "#54402F",
      "icons_attention": "#AD4E00",
      "button_background_hover": "#DBCDB3",
      "button_background_active": "#CBB898",
      "toolbar_field": "#EEE4D0",
      "toolbar_field_text": "#3E2C1E",
      "toolbar_field_border": "#CBB898",
      "toolbar_field_focus": "#F8EFDF",
      "toolbar_field_text_focus": "#2A1D13",
      "toolbar_field_border_focus": "#AD4E00",
      "toolbar_field_highlight": "#CBB898",
      "toolbar_field_highlight_text": "#2A1D13",
      "toolbar_field_separator": "#CBB898",
      "popup": "#FCF7EF",
      "popup_text": "#3E2C1E",
      "popup_border": "#E1DAD1",
      "popup_highlight": "#CBB898",
      "popup_highlight_text": "#2A1D13",
      "sidebar": "#EEE4D0",
      "sidebar_text": "#3E2C1E",
      "sidebar_border": "#CBB898",
      "sidebar_highlight": "#CBB898",
      "sidebar_highlight_text": "#2A1D13",
      "ntp_background": "#F8EFDF",
      "ntp_card_background": "#EEE4D0",
      "ntp_text": "#3E2C1E",
      "spaces_bg": "#E4D8C0",
      "spaces_bg_active": "#AD4E00",
      "spaces_button": "#F8EFDF",
      "tree_view_bg": "#F8EFDF",
      "button_primary_bg": "#AD4E00",
      "button_text": "#F8EFDF",
      "tree_pane_bg": "#EEE4D0",
      "tree_card_bg": "#F8EFDF",
      "button_bg": "#EEE4D0",
      "list_container_background_selected_current": "#CBB898",
      "calendar_view_toggle_bg": "#EEE4D0",
      "calendar_view_toggle_hover_bg": "#DBCDB3",
      "tabs_toolbar_bg": "#E4D8C0",
      "lwt_accent_color": "#E4D8C0",
      "layout_bg_0": "#F8EFDF",
      "layout_bg_1": "#EEE4D0",
      "layout_bg_2": "#EEE4D0",
      "layout_bg_3": "#FCF7EF",
      "layout_bg_4": "#DBCDB3",
      "layout_color_0": "#2A1D13",
      "layout_color_1": "#3E2C1E",
      "layout_color_2": "#54402F",
      "layout_color_3": "#735C44",
      "layout_border_0": "#CBB898",
      "layout_border_1": "#BAA380",
      "layout_border_2": "#A58D6D"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
