{
  "manifest_version": 2,
  "name": "Subway Seat Enamel",
  "version": "0.2.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Cream enamel panels in the morning sun. The light one. (Subway Seat \u2014 generated from palette.py by build.py. Edit the palette, not this file.)",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "subway-seat-enamel-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "bg_color": "--bg-color",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color"
    }
  },
  "theme": {
    "colors": {
      "frame": "#E2D3B6",
      "frame_inactive": "#EBDEC6",
      "tab_background_text": "#735C44",
      "tab_background_separator": "#CAB48E",
      "tab_selected": "#F4E9D4",
      "tab_text": "#3E2C1E",
      "tab_line": "#C4561A",
      "tab_loading": "#C4561A",
      "toolbar": "#F4E9D4",
      "toolbar_text": "#3E2C1E",
      "toolbar_top_separator": "#E2D3B6",
      "toolbar_bottom_separator": "#CAB48E",
      "toolbar_vertical_separator": "#CAB48E",
      "icons": "#54402F",
      "icons_attention": "#C4561A",
      "button_background_hover": "#D9C8A7",
      "button_background_active": "#CAB48E",
      "toolbar_field": "#EBDEC6",
      "toolbar_field_text": "#3E2C1E",
      "toolbar_field_border": "#CAB48E",
      "toolbar_field_focus": "#F4E9D4",
      "toolbar_field_text_focus": "#2A1D13",
      "toolbar_field_border_focus": "#C4561A",
      "toolbar_field_highlight": "#CAB48E",
      "toolbar_field_highlight_text": "#2A1D13",
      "toolbar_field_separator": "#CAB48E",
      "popup": "#F4E9D4",
      "popup_text": "#3E2C1E",
      "popup_border": "#CAB48E",
      "popup_highlight": "#CAB48E",
      "popup_highlight_text": "#2A1D13",
      "sidebar": "#EBDEC6",
      "sidebar_text": "#3E2C1E",
      "sidebar_border": "#CAB48E",
      "sidebar_highlight": "#CAB48E",
      "sidebar_highlight_text": "#2A1D13",
      "ntp_background": "#F4E9D4",
      "ntp_card_background": "#EBDEC6",
      "ntp_text": "#3E2C1E",
      "spaces_bg": "#E2D3B6",
      "spaces_bg_active": "#C4561A",
      "spaces_button": "#F4E9D4",
      "tree_view_bg": "#F4E9D4",
      "bg_color": "#F4E9D4",
      "button_primary_bg": "#C4561A",
      "button_text": "#F4E9D4",
      "tree_pane_bg": "#EBDEC6",
      "tree_card_bg": "#F4E9D4",
      "layout_bg_0": "#F4E9D4",
      "layout_bg_1": "#EBDEC6",
      "button_bg": "#EBDEC6",
      "list_container_background_selected_current": "#CAB48E",
      "calendar_view_toggle_bg": "#EBDEC6",
      "calendar_view_toggle_hover_bg": "#D9C8A7",
      "tabs_toolbar_bg": "#E2D3B6"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
