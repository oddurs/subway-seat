      "calendar_view_toggle_hover_bg": "#B6D2C5",
      "tabs_toolbar_bg": "#C8DAD1",
      "lwt_accent_color": "#C8DAD1",
      "layout_bg_0": "#E2EDE8",
      "layout_bg_1": "#D5E3DD",
      "layout_bg_2": "#D5E3DD",
      "layout_bg_3": "#F0F6F4",
      "layout_bg_4": "#B6D2C5",
      "layout_color_0": "#16241E",
