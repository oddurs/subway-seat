{
  "manifest_version": 2,
  "name": "Paris Carrelage",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Bevelled white tile under a vaulted platform. The light one.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "paris-carrelage-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#D4DCD3",
      "frame_inactive": "#E1E7E0",
      "tab_background_text": "#586459",
      "tab_background_separator": "#B1C0B0",
      "tab_selected": "#EEF3ED",
      "tab_text": "#2A342B",
      "tab_line": "#8A5308",
      "tab_loading": "#8A5308",
      "toolbar": "#EEF3ED",
      "toolbar_text": "#2A342B",
      "toolbar_top_separator": "#D4DCD3",
      "toolbar_bottom_separator": "#B1C0B0",
      "toolbar_vertical_separator": "#B1C0B0",
      "icons": "#3D473E",
      "icons_attention": "#8A5308",
      "button_background_hover": "#C7D3C5",
      "button_background_active": "#B1C0B0",
      "toolbar_field": "#E1E7E0",
      "toolbar_field_text": "#2A342B",
      "toolbar_field_border": "#B1C0B0",
      "toolbar_field_focus": "#EEF3ED",
      "toolbar_field_text_focus": "#1B221C",
      "toolbar_field_border_focus": "#8A5308",
      "toolbar_field_highlight": "#B1C0B0",
      "toolbar_field_highlight_text": "#1B221C",
      "toolbar_field_separator": "#B1C0B0",
      "popup": "#F6F9F6",
      "popup_text": "#2A342B",
      "popup_border": "#D9DDD9",
      "popup_highlight": "#B1C0B0",
      "popup_highlight_text": "#1B221C",
      "sidebar": "#E1E7E0",
      "sidebar_text": "#2A342B",
      "sidebar_border": "#B1C0B0",
      "sidebar_highlight": "#B1C0B0",
      "sidebar_highlight_text": "#1B221C",
      "ntp_background": "#EEF3ED",
      "ntp_card_background": "#E1E7E0",
      "ntp_text": "#2A342B",
      "spaces_bg": "#D4DCD3",
      "spaces_bg_active": "#8A5308",
      "spaces_button": "#EEF3ED",
      "tree_view_bg": "#EEF3ED",
      "button_primary_bg": "#8A5308",
      "button_text": "#EEF3ED",
      "tree_pane_bg": "#E1E7E0",
      "tree_card_bg": "#EEF3ED",
      "button_bg": "#E1E7E0",
      "list_container_background_selected_current": "#B1C0B0",
      "calendar_view_toggle_bg": "#E1E7E0",
      "calendar_view_toggle_hover_bg": "#C7D3C5",
      "tabs_toolbar_bg": "#D4DCD3",
      "lwt_accent_color": "#D4DCD3",
      "layout_bg_0": "#EEF3ED",
      "layout_bg_1": "#E1E7E0",
      "layout_bg_2": "#E1E7E0",
      "layout_bg_3": "#F6F9F6",
      "layout_bg_4": "#C7D3C5",
      "layout_color_0": "#1B221C",
      "layout_color_1": "#2A342B",
      "layout_color_2": "#3D473E",
      "layout_color_3": "#586459",
      "layout_border_0": "#B1C0B0",
      "layout_border_1": "#9BAC9A",
      "layout_border_2": "#879887"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
