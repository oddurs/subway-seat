      "toolbar_field_border_focus": "#9B5D00",
      "toolbar_field_highlight": "#9DC1B1",
      "toolbar_field_highlight_text": "#16241E",
      "toolbar_field_separator": "#9DC1B1",
      "popup": "#F0F6F4",
      "popup_text": "#21352D",
      "popup_border": "#D3DBD8",
      "popup_highlight": "#9DC1B1",
      "popup_highlight_text": "#16241E",
      "sidebar": "#D5E3DD",
      "sidebar_text": "#21352D",
      "sidebar_border": "#9DC1B1",
