      "button_bg": "#D0E6D8",
      "list_container_background_selected_current": "#96C4AC",
      "calendar_view_toggle_bg": "#D0E6D8",
      "calendar_view_toggle_hover_bg": "#ACD5BF",
      "tabs_toolbar_bg": "#BFDDCD",
      "lwt_accent_color": "#BFDDCD",
      "layout_bg_0": "#DEF0E6",
      "layout_bg_1": "#D0E6D8",
      "layout_bg_2": "#D0E6D8",
      "layout_bg_3": "#EEF8F2",
      "layout_bg_4": "#ACD5BF",
      "layout_color_0": "#18231D",
      "layout_color_1": "#25352C",
      "layout_color_2": "#374940",
      "layout_color_3": "#4F675B",
      "layout_border_0": "#96C4AC",
      "layout_border_1": "#84B09A",
      "layout_border_2": "#769B87"
