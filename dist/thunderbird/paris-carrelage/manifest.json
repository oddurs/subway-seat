{
  "manifest_version": 2,
  "name": "Paris Carrelage",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Bevelled white tile under a vaulted platform. The light one.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "paris-carrelage-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#BFDDCD",
      "frame_inactive": "#D0E6D8",
      "tab_background_text": "#4F675B",
      "tab_background_separator": "#96C4AC",
      "tab_selected": "#DEF0E6",
      "tab_text": "#25352C",
      "tab_line": "#754500",
      "tab_loading": "#754500",
      "toolbar": "#DEF0E6",
      "toolbar_text": "#25352C",
      "toolbar_top_separator": "#BFDDCD",
      "toolbar_bottom_separator": "#96C4AC",
      "toolbar_vertical_separator": "#96C4AC",
      "icons": "#374940",
      "icons_attention": "#754500",
      "button_background_hover": "#ACD5BF",
      "button_background_active": "#96C4AC",
      "toolbar_field": "#D0E6D8",
      "toolbar_field_text": "#25352C",
      "toolbar_field_border": "#96C4AC",
      "toolbar_field_focus": "#DEF0E6",
      "toolbar_field_text_focus": "#18231D",
      "toolbar_field_border_focus": "#754500",
      "toolbar_field_highlight": "#96C4AC",
      "toolbar_field_highlight_text": "#18231D",
      "toolbar_field_separator": "#96C4AC",
      "popup": "#EEF8F2",
      "popup_text": "#25352C",
      "popup_border": "#D2DCD6",
      "popup_highlight": "#96C4AC",
      "popup_highlight_text": "#18231D",
      "sidebar": "#D0E6D8",
      "sidebar_text": "#25352C",
      "sidebar_border": "#96C4AC",
      "sidebar_highlight": "#96C4AC",
      "sidebar_highlight_text": "#18231D",
      "ntp_background": "#DEF0E6",
      "ntp_card_background": "#D0E6D8",
      "ntp_text": "#25352C",
      "spaces_bg": "#BFDDCD",
      "spaces_bg_active": "#754500",
      "spaces_button": "#DEF0E6",
      "tree_view_bg": "#DEF0E6",
      "button_primary_bg": "#754500",
      "button_text": "#DEF0E6",
      "tree_pane_bg": "#D0E6D8",
