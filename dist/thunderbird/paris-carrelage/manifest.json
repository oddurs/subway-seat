      "toolbar_top_separator": "#C8DAD1",
      "toolbar_bottom_separator": "#9DC1B1",
      "toolbar_vertical_separator": "#9DC1B1",
      "icons": "#334A41",
      "icons_attention": "#9B5D00",
      "button_background_hover": "#B6D2C5",
      "button_background_active": "#9DC1B1",
