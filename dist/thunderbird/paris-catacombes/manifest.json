{
  "manifest_version": 2,
  "name": "Paris Catacombes",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Under the quarries: the same green with the lights turned down.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "paris-catacombes-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#05120C",
      "frame_inactive": "#05120C",
      "tab_background_text": "#829D91",
      "tab_background_separator": "#0A2B20",
      "tab_selected": "#062017",
      "tab_text": "#CFDED7",
      "tab_line": "#D78E3C",
      "tab_loading": "#D78E3C",
      "toolbar": "#062017",
      "toolbar_text": "#CFDED7",
      "toolbar_top_separator": "#05120C",
      "toolbar_bottom_separator": "#0A2B20",
      "toolbar_vertical_separator": "#0A2B20",
      "icons": "#B8CAC2",
      "icons_attention": "#D78E3C",
      "button_background_hover": "#0A2B20",
      "button_background_active": "#13382A",
      "toolbar_field": "#061811",
      "toolbar_field_text": "#CFDED7",
      "toolbar_field_border": "#0A2B20",
      "toolbar_field_focus": "#061811",
      "toolbar_field_text_focus": "#E4EEE9",
      "toolbar_field_border_focus": "#D78E3C",
      "toolbar_field_highlight": "#1E4738",
      "toolbar_field_highlight_text": "#E4EEE9",
      "toolbar_field_separator": "#0A2B20",
      "popup": "#0A2B20",
      "popup_text": "#CFDED7",
      "popup_border": "#224136",
      "popup_highlight": "#1E4738",
      "popup_highlight_text": "#E4EEE9",
      "sidebar": "#061811",
      "sidebar_text": "#CFDED7",
      "sidebar_border": "#0A2B20",
      "sidebar_highlight": "#1E4738",
      "sidebar_highlight_text": "#E4EEE9",
      "ntp_background": "#062017",
      "ntp_card_background": "#0A2B20",
      "ntp_text": "#CFDED7",
      "spaces_bg": "#05120C",
      "spaces_bg_active": "#D78E3C",
      "spaces_button": "#05120C",
      "tree_view_bg": "#062017",
      "button_primary_bg": "#D78E3C",
      "button_text": "#05120C",
      "tree_pane_bg": "#061811",
      "tree_card_bg": "#062017",
      "button_bg": "#0A2B20",
      "list_container_background_selected_current": "#1E4738",
      "calendar_view_toggle_bg": "#061811",
      "calendar_view_toggle_hover_bg": "#0A2B20",
      "tabs_toolbar_bg": "#05120C",
      "lwt_accent_color": "#05120C",
      "layout_bg_0": "#062017",
      "layout_bg_1": "#061811",
      "layout_bg_2": "#061811",
      "layout_bg_3": "#0A2B20",
      "layout_bg_4": "#13382A",
      "layout_color_0": "#E4EEE9",
      "layout_color_1": "#CFDED7",
      "layout_color_2": "#B8CAC2",
      "layout_color_3": "#829D91",
      "layout_border_0": "#0A2B20",
      "layout_border_1": "#13382A",
      "layout_border_2": "#456A5B"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
