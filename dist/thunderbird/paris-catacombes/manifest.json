{
  "manifest_version": 2,
  "name": "Paris Catacombes",
  "version": "0.3.0",
  "description": "A walnut-brown 1970s NYC subway theme: harvest gold, burnt orange and avocado on warm wood. Under the quarries: the same green with the lights turned down.",
  "author": "Oddur Sigurdsson",
  "homepage_url": "https://github.com/oddurs/subway-seat",
  "browser_specific_settings": {
    "gecko": {
      "id": "paris-catacombes-thunderbird@oddurs.github.io",
      "strict_min_version": "115.0"
    }
  },
  "theme_experiment": {
    "colors": {
      "spaces_bg": "--spaces-bg-color",
      "spaces_bg_active": "--spaces-button-active-bg-color",
      "spaces_button": "--spaces-button-active-text-color",
      "tree_view_bg": "--tree-view-bg",
      "button_primary_bg": "--button-primary-background-color",
      "button_text": "--button-primary-text-color",
      "tree_pane_bg": "--tree-pane-background",
      "tree_card_bg": "--tree-card-background",
      "button_bg": "--button-background-color",
      "list_container_background_selected_current": "--list-container-background-selected-current",
      "calendar_view_toggle_bg": "--calendar-view-toggle-background",
      "calendar_view_toggle_hover_bg": "--calendar-view-toggle-hover-background",
      "tabs_toolbar_bg": "--tabs-toolbar-background-color",
      "lwt_accent_color": "--lwt-accent-color",
      "layout_bg_0": "--layout-background-0",
      "layout_bg_1": "--layout-background-1",
      "layout_bg_2": "--layout-background-2",
      "layout_bg_3": "--layout-background-3",
      "layout_bg_4": "--layout-background-4",
      "layout_color_0": "--layout-color-0",
      "layout_color_1": "--layout-color-1",
      "layout_color_2": "--layout-color-2",
      "layout_color_3": "--layout-color-3",
      "layout_border_0": "--layout-border-0",
      "layout_border_1": "--layout-border-1",
      "layout_border_2": "--layout-border-2"
    }
  },
  "theme": {
    "colors": {
      "frame": "#0B100D",
      "frame_inactive": "#0B100D",
      "tab_background_text": "#8E9993",
      "tab_background_separator": "#1D2822",
      "tab_selected": "#141D19",
      "tab_text": "#D5DCD8",
      "tab_line": "#D0914F",
      "tab_loading": "#D0914F",
      "toolbar": "#141D19",
      "toolbar_text": "#D5DCD8",
      "toolbar_top_separator": "#0B100D",
      "toolbar_bottom_separator": "#1D2822",
      "toolbar_vertical_separator": "#1D2822",
      "icons": "#C0C7C3",
      "icons_attention": "#D0914F",
      "button_background_hover": "#1D2822",
      "button_background_active": "#27332D",
      "toolbar_field": "#0F1612",
      "toolbar_field_text": "#D5DCD8",
      "toolbar_field_border": "#1D2822",
      "toolbar_field_focus": "#0F1612",
      "toolbar_field_text_focus": "#E8ECEA",
      "toolbar_field_border_focus": "#D0914F",
      "toolbar_field_highlight": "#34423B",
      "toolbar_field_highlight_text": "#E8ECEA",
      "toolbar_field_separator": "#1D2822",
      "popup": "#1D2822",
      "popup_text": "#D5DCD8",
      "popup_border": "#333E38",
      "popup_highlight": "#34423B",
      "popup_highlight_text": "#E8ECEA",
      "sidebar": "#0F1612",
      "sidebar_text": "#D5DCD8",
      "sidebar_border": "#1D2822",
      "sidebar_highlight": "#34423B",
      "sidebar_highlight_text": "#E8ECEA",
      "ntp_background": "#141D19",
      "ntp_card_background": "#1D2822",
      "ntp_text": "#D5DCD8",
      "spaces_bg": "#0B100D",
      "spaces_bg_active": "#D0914F",
      "spaces_button": "#0B100D",
      "tree_view_bg": "#141D19",
      "button_primary_bg": "#D0914F",
      "button_text": "#0B100D",
      "tree_pane_bg": "#0F1612",
      "tree_card_bg": "#141D19",
      "button_bg": "#1D2822",
      "list_container_background_selected_current": "#34423B",
      "calendar_view_toggle_bg": "#0F1612",
      "calendar_view_toggle_hover_bg": "#1D2822",
      "tabs_toolbar_bg": "#0B100D",
      "lwt_accent_color": "#0B100D",
      "layout_bg_0": "#141D19",
      "layout_bg_1": "#0F1612",
      "layout_bg_2": "#0F1612",
      "layout_bg_3": "#1D2822",
      "layout_bg_4": "#27332D",
      "layout_color_0": "#E8ECEA",
      "layout_color_1": "#D5DCD8",
      "layout_color_2": "#C0C7C3",
      "layout_color_3": "#8E9993",
      "layout_border_0": "#1D2822",
      "layout_border_1": "#27332D",
      "layout_border_2": "#57645D"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
