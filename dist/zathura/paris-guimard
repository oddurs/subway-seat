# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Guimard for zathura. In zathurarc: include paris-guimard

# window
set default-bg              "#1E2E26"
set default-fg              "#D9E1DB"
set statusbar-bg            "#18241D"
set statusbar-fg            "#C2CBC5"
set inputbar-bg             "#18241D"
set inputbar-fg             "#D9E1DB"

# notifications
set notification-bg         "#263930"
set notification-fg         "#D9E1DB"
set notification-error-bg   "#CD6B63"
set notification-error-fg   "#131A17"
set notification-warning-bg "#F2BF4B"
set notification-warning-fg "#131A17"

# completion
set completion-bg           "#263930"
set completion-fg           "#D9E1DB"
set completion-group-bg     "#18241D"
set completion-group-fg     "#A9B5AE"
set completion-highlight-bg "#3E554A"
set completion-highlight-fg "#E9EEEC"

# index (table of contents)
set index-bg                "#1E2E26"
set index-fg                "#D9E1DB"
set index-active-bg         "#3E554A"
set index-active-fg         "#E9EEEC"

# search hits and link hints, washed over the page
set highlight-color         "rgba(242,191,75,0.3)"
set highlight-active-color  "rgba(208,145,79,0.5)"
set highlight-fg            "#E9EEEC"

# pages while they render
set render-loading-bg       "#1E2E26"
set render-loading-fg       "#74857C"

# digital signatures
set signature-success-color "#80C28E"
set signature-warning-color "#F2BF4B"
set signature-error-color   "#EE8F85"

# recoloring: white paper → base, black ink → text; Ctrl+R toggles it
set recolor-lightcolor      "#1E2E26"
set recolor-darkcolor       "#D9E1DB"
set recolor                 "true"
set recolor-keephue         "true"
set recolor-reverse-video   "true"
