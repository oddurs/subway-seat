# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Catacombes for zathura. In zathurarc: include paris-catacombes

# window
set default-bg              "#141D19"
set default-fg              "#D5DCD8"
set statusbar-bg            "#0F1612"
set statusbar-fg            "#C0C7C3"
set inputbar-bg             "#0F1612"
set inputbar-fg             "#D5DCD8"

# notifications
set notification-bg         "#1D2822"
set notification-fg         "#D5DCD8"
set notification-error-bg   "#CD6B63"
set notification-error-fg   "#0B100D"
set notification-warning-bg "#EBC168"
set notification-warning-fg "#0B100D"

# completion
set completion-bg           "#1D2822"
set completion-fg           "#D5DCD8"
set completion-group-bg     "#0F1612"
set completion-group-fg     "#A7B0AB"
set completion-highlight-bg "#34423B"
set completion-highlight-fg "#E8ECEA"

# index (table of contents)
set index-bg                "#141D19"
set index-fg                "#D5DCD8"
set index-active-bg         "#34423B"
set index-active-fg         "#E8ECEA"

# search hits and link hints, washed over the page
set highlight-color         "rgba(235,193,104,0.3)"
set highlight-active-color  "rgba(208,145,79,0.5)"
set highlight-fg            "#E8ECEA"

# pages while they render
set render-loading-bg       "#141D19"
set render-loading-fg       "#738079"

# digital signatures
set signature-success-color "#80C28E"
set signature-warning-color "#EBC168"
set signature-error-color   "#E1837A"

# recoloring: white paper → base, black ink → text; Ctrl+R toggles it
set recolor-lightcolor      "#141D19"
set recolor-darkcolor       "#D5DCD8"
set recolor                 "true"
set recolor-keephue         "true"
set recolor-reverse-video   "true"
