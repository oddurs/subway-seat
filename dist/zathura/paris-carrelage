# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Carrelage for zathura. In zathurarc: include paris-carrelage

# window
set default-bg              "#E4EDE8"
set default-fg              "#25352C"
set statusbar-bg            "#D8E3DC"
set statusbar-fg            "#374940"
set inputbar-bg             "#D8E3DC"
set inputbar-fg             "#25352C"

# notifications
set notification-bg         "#F2F6F4"
set notification-fg         "#25352C"
set notification-error-bg   "#9E171B"
set notification-error-fg   "#E4EDE8"
set notification-warning-bg "#8A6700"
set notification-warning-fg "#E4EDE8"

# completion
set completion-bg           "#F2F6F4"
set completion-fg           "#25352C"
set completion-group-bg     "#D8E3DC"
set completion-group-fg     "#45594F"
set completion-highlight-bg "#A3BFB0"
set completion-highlight-fg "#18231D"

# index (table of contents)
set index-bg                "#E4EDE8"
set index-fg                "#25352C"
set index-active-bg         "#A3BFB0"
set index-active-fg         "#18231D"

# search hits and link hints, washed over the page
set highlight-color         "rgba(138,103,0,0.3)"
set highlight-active-color  "rgba(155,93,0,0.5)"
set highlight-fg            "#18231D"

# pages while they render
set render-loading-bg       "#E4EDE8"
set render-loading-fg       "#627F70"

# digital signatures
set signature-success-color "#18803F"
set signature-warning-color "#8A6700"
set signature-error-color   "#BB403B"

# recoloring: white paper → base, black ink → text; Ctrl+R toggles it
set recolor-lightcolor      "#E4EDE8"
set recolor-darkcolor       "#25352C"
set recolor                 "true"
set recolor-keephue         "true"
set recolor-reverse-video   "true"
