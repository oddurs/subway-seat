# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Paris Carrelage for zathura. In zathurarc: include paris-carrelage

# window
set default-bg              "#EEF2F1"
set default-fg              "#27342F"
set statusbar-bg            "#E1E6E5"
set statusbar-fg            "#3B4742"
set inputbar-bg             "#E1E6E5"
set inputbar-fg             "#27342F"

# notifications
set notification-bg         "#F6F8F8"
set notification-fg         "#27342F"
set notification-error-bg   "#88251E"
set notification-error-fg   "#EEF2F1"
set notification-warning-bg "#916D07"
set notification-warning-fg "#EEF2F1"

# completion
set completion-bg           "#F6F8F8"
set completion-fg           "#27342F"
set completion-group-bg     "#E1E6E5"
set completion-group-fg     "#4A5752"
set completion-highlight-bg "#B0BFBB"
set completion-highlight-fg "#19221E"

# index (table of contents)
set index-bg                "#EEF2F1"
set index-fg                "#27342F"
set index-active-bg         "#B0BFBB"
set index-active-fg         "#19221E"

# search hits and link hints, washed over the page
set highlight-color         "rgba(145,109,7,0.3)"
set highlight-active-color  "rgba(118,76,0,0.5)"
set highlight-fg            "#19221E"

# pages while they render
set render-loading-bg       "#EEF2F1"
set render-loading-fg       "#6C7C76"

# digital signatures
set signature-success-color "#218366"
set signature-warning-color "#916D07"
set signature-error-color   "#AC3B32"

# recoloring: white paper → base, black ink → text; Ctrl+R toggles it
set recolor-lightcolor      "#EEF2F1"
set recolor-darkcolor       "#27342F"
set recolor                 "true"
set recolor-keephue         "true"
set recolor-reverse-video   "true"
