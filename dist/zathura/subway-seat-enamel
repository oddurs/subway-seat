# Subway Seat — generated from palette.py by build.py. Edit the palette, not this file.
# Subway Seat Enamel for zathura. In zathurarc: include subway-seat-enamel

# window
set default-bg              "#F4E9D4"
set default-fg              "#3E2C1E"
set statusbar-bg            "#EBDEC6"
set statusbar-fg            "#54402F"
set inputbar-bg             "#EBDEC6"
set inputbar-fg             "#3E2C1E"

# notifications
set notification-bg         "#FAF4EA"
set notification-fg         "#3E2C1E"
set notification-error-bg   "#992418"
set notification-error-fg   "#F4E9D4"
set notification-warning-bg "#936200"
set notification-warning-fg "#F4E9D4"

# completion
set completion-bg           "#FAF4EA"
set completion-fg           "#3E2C1E"
set completion-group-bg     "#EBDEC6"
set completion-group-fg     "#654F3B"
set completion-highlight-bg "#CAB48E"
set completion-highlight-fg "#2A1D13"

# index (table of contents)
set index-bg                "#F4E9D4"
set index-fg                "#3E2C1E"
set index-active-bg         "#CAB48E"
set index-active-fg         "#2A1D13"

# search hits and link hints, washed over the page
set highlight-color         "rgba(147,98,0,0.3)"
set highlight-active-color  "rgba(173,78,0,0.5)"
set highlight-fg            "#2A1D13"

# pages while they render
set render-loading-bg       "#F4E9D4"
set render-loading-fg       "#8C7254"

# digital signatures
set signature-success-color "#66740F"
set signature-warning-color "#936200"
set signature-error-color   "#BC4031"

# recoloring: white paper → base, black ink → text; Ctrl+R toggles it
set recolor-lightcolor      "#F4E9D4"
set recolor-darkcolor       "#3E2C1E"
set recolor                 "true"
set recolor-keephue         "true"
set recolor-reverse-video   "true"
