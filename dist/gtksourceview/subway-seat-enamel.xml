  <color name="tint_chg_emph" value="#DCCDAD"/>
  <color name="tint_info" value="#DBD6C8"/>
  <color name="tint_hint" value="#DBD8C2"/>
  <color name="tint_search" value="#D7C094"/>
  <color name="tint_search_cur" value="#D09C6A"/>
  <color name="selection_unfocused" value="#DDCCAE"/>
  <color name="bracket_bg" value="#E7DCC7"/>

