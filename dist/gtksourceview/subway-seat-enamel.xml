  <color name="subtext1" value="#54402F"/>
  <color name="text" value="#3E2C1E"/>
  <color name="text_hi" value="#2A1D13"/>
  <color name="yellow" value="#936200"/>
  <color name="yellow_hi" value="#A56E00"/>
  <color name="orange" value="#AD4E00"/>
  <color name="orange_hi" value="#C4561A"/>
  <color name="red" value="#992418"/>
