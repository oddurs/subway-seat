{
  "name": "subway-seat-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "theme": "python3 ../build.py",
    "predev": "bun run theme",
    "dev": "next dev --port 8502",
    "prebuild": "bun run theme",
    "build": "next build",
    "start": "next start --port 8502",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && biome format .",
    "check:links": "bun scripts/check-links.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
