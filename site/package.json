{
  "name": "subway-seat-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "theme": "python3 ../build.py",
    "predev": "bun run theme",
    "dev": "next dev --port 8502",
    "prebuild": "bun run theme",
    "build": "next build",
    "start": "next start --port 8502",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && biome format ."
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/postcss-plugin": "0.19.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.6",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "typescript": "^7"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
