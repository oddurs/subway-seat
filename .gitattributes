# Text is stored and checked out with LF everywhere, so dist/ is byte-identical on Windows.
* text=auto eol=lf

# Binaries: no line-ending conversion, no text diffs.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.vsix binary
*.jar binary
*.xpi binary
*.zip binary
*.swatches binary
*.ase binary
# Telegram's zipped themes; dist/telegram/*/colors.tdesktop-theme stays text.
dist/telegram/*.tdesktop-theme binary

# Generated by build.py from palette.py: collapsed in diffs, left out of language stats.
dist/** linguist-generated=true
site/src/theme/tokens.stylex.ts linguist-generated=true
site/src/theme/flavors.ts linguist-generated=true
site/src/theme/palette.json linguist-generated=true
site/bun.lock linguist-generated=true
uv.lock linguist-generated=true
