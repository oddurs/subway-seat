# Text is stored and checked out with LF everywhere, so dist/ is byte-identical on Windows.
* text=auto eol=lf

# Binaries: no line-ending conversion, no text diffs.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.vsix binary
*.jar binary
*.xpi binary
*.zip binary
*.swatches binary
*.ase binary
# Telegram's zipped themes; dist/telegram/*/colors.tdesktop-theme stays text.
dist/telegram/*.tdesktop-theme binary

# Generated by build.py from palette.py: collapsed in diffs, left out of language stats.
dist/** linguist-generated=true
site/src/theme/tokens.stylex.ts linguist-generated=true
site/src/theme/flavors.ts linguist-generated=true
site/src/theme/palette.json linguist-generated=true
site/bun.lock linguist-generated=true
uv.lock linguist-generated=true

# …and rebuilt on merge rather than resolved. A palette change rewrites every
# one of them, so two branches that both touch a color conflict in ~1,600 files,
# some of them binaries git cannot even diff — and the resolution is never to
# pick a side, it is to run build.py. This driver keeps whichever side you are
# on and lets the rebuild settle it; CI's `build.py --check` fails if you forget.
# The driver itself lives outside the repo, so it needs saying once per clone:
#   git config merge.generated.driver true
dist/** merge=generated
site/src/theme/tokens.stylex.ts merge=generated
site/src/theme/flavors.ts merge=generated
site/src/theme/palette.json merge=generated
